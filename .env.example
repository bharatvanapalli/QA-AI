# ── Server ───────────────────────────────────────────────────
PORT=5000
NODE_ENV=development
ALLOWED_ORIGIN=http://localhost:5173

# ── Database ─────────────────────────────────────────────────
# Default: SQLite (zero install). Production: switch to Postgres.
DATABASE_URL=file:./dev.db
# Postgres alternative:
# DATABASE_URL=postgresql://qaai:qaai_dev_password@localhost:5432/qaai?schema=public

# ── Auth secrets (CHANGE IN PRODUCTION) ──────────────────────
JWT_SECRET=replace-me-with-a-long-random-string
JWT_REFRESH_SECRET=replace-me-with-a-different-long-random-string
JWT_TTL=15m
REFRESH_TTL_DAYS=7

# ── Vault encryption master key (CHANGE IN PRODUCTION) ───────
# Must be at least 32 chars. Used to derive AES-256-GCM key via scrypt.
VAULT_MASTER_KEY=replace-me-with-32-bytes-of-randomness

# ── SMTP (defaults to MailHog from docker-compose) ───────────
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASS=
SMTP_FROM="QAAI <no-reply@qaai.local>"

# ── Playwright target ────────────────────────────────────────
QAAI_TARGET_URL=https://demo.playwright.dev/todomvc

# ── Frontend ─────────────────────────────────────────────────
VITE_API_URL=http://localhost:5000/api
VITE_WS_URL=ws://localhost:5000

# ── 21st.dev Magic MCP (component generation) ────────────────
# Get a free key at https://21st.dev/magic/console — read by .mcp.json
TWENTYFIRST_API_KEY=

# Firecrawl source grounding (optional; context only, never execution proof)
# Enable both flags to crawl public docs/help/wiki URLs during generation.
QAAI_FIRECRAWL_INTAKE_ENABLED=false
QAAI_FIRECRAWL_LIVE_CRAWL_ENABLED=false
FIRECRAWL_API_KEY=
FIRECRAWL_API_URL=https://api.firecrawl.dev/v2
QAAI_FIRECRAWL_MAX_URLS=3
QAAI_FIRECRAWL_MAX_PAGES_PER_URL=5
QAAI_FIRECRAWL_MAX_DEPTH=1
QAAI_FIRECRAWL_TIMEOUT_MS=15000
