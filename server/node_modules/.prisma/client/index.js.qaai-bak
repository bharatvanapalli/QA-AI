  "inlineDatasources": {
    "db": {
      "url": {
        "fromEnvVar": "DATABASE_URL",
        "value": null
      }
    }
  },
  "inlineSchema": "// QAAI Prisma schema — SQLite (development).\n//\n// To switch to PostgreSQL for production:\n//   1. Change provider below to \"postgresql\"\n//   2. Set DATABASE_URL to a postgres connection string\n//   3. Re-enable `String[]` types (currently stored as JSON-encoded String for\n//      SQLite compatibility — see WebhookConfig.events and RunResult.screenshots)\n//   4. Delete prisma/migrations and re-run `npx prisma migrate dev --name init`\n//\n// Generate client : npx prisma generate\n// Run migration   : npx prisma migrate dev\n\ngenerator client {\n  provider = \"prisma-client-js\"\n  output   = \"../server/node_modules/.prisma/client\"\n}\n\ndatasource db {\n  provider = \"sqlite\"\n  url      = env(\"DATABASE_URL\")\n}\n\n// ── Users & sessions ─────────────────────────────────────────\nmodel User {\n  id              String    @id @default(uuid())\n  email           String    @unique\n  passwordHash    String\n  firstName       String?\n  lastName        String?\n  role            String    @default(\"user\") // user | admin | lead (platform role)\n  organisation    String?\n  // Phase E8 — multi-tenancy. currentOrgId pins the org the user is\n  // actively working in. New rows (projects, secrets, etc.) get this\n  // orgId stamped on them. Switching orgs (when E8 invites land) flips\n  // this field via PUT /api/org/switch.\n  currentOrgId    String?\n  // Phase E10.3 — per-user daily token ceiling. null = use system\n  // default (BUDGET_DEFAULT_DAILY_TOKENS env). Override per user in\n  // Settings → AI Provider when a heavy user wants more headroom.\n  dailyTokenLimit Int?\n  createdAt       DateTime  @default(now())\n  updatedAt       DateTime  @updatedAt\n  lastLoginAt     DateTime?\n\n  sessions          Session[]\n  projects          Project[]\n  secrets           Secret[]\n  integrations      Integration[]\n  webhookConfigs    WebhookConfig[]\n  notificationChans NotificationChannel[]\n  auditLogs         AuditLog[]\n  runs              Run[]\n  agentRuns         AgentRun[]\n  dailyUsage        UserDailyUsage[]\n  // E8 — org memberships + ownership + sent invites\n  ownedOrgs         Organization[]        @relation(\"OrgOwner\")\n  orgMemberships    OrgMembership[]\n  sentInvites       OrgInvite[]           @relation(\"OrgInviteSender\")\n}\n\n// ── Phase E8 — Multi-tenancy substrate ──────────────────────\n//\n// An Organization is the tenancy boundary. Every Project, Secret,\n// Integration, WebhookConfig, NotificationChannel, and AuditLog row is\n// scoped to one Org. Users belong to one or more Orgs via OrgMembership;\n// `User.currentOrgId` pins the active org for the session.\n//\n// Owner is the user who created the org. Owner has full control\n// (rename, invite, remove members, transfer ownership in a future\n// phase). Members and admins are added via OrgInvite → OrgMembership.\nmodel Organization {\n  id        String   @id @default(uuid())\n  name      String\n  slug      String   @unique // url-safe identifier; auto-derived from name\n  ownerId   String\n  plan      String   @default(\"solo\") // 'solo' | 'team' | 'enterprise'\n  createdAt DateTime @default(now())\n  updatedAt DateTime @updatedAt\n\n  owner       User            @relation(\"OrgOwner\", fields: [ownerId], references: [id], onDelete: Cascade)\n  memberships OrgMembership[]\n  invites     OrgInvite[]\n\n  @@index([ownerId])\n}\n\nmodel OrgMembership {\n  id        String   @id @default(uuid())\n  orgId     String\n  userId    String\n  role      String   @default(\"member\") // 'owner' | 'admin' | 'member'\n  createdAt DateTime @default(now())\n\n  organization Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)\n  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)\n\n  @@unique([orgId, userId])\n  @@index([userId])\n}\n\nmodel OrgInvite {\n  id         String    @id @default(uuid())\n  orgId      String\n  email      String // who we're inviting (case-insensitive match at accept time)\n  role       String    @default(\"member\")\n  token      String    @unique // random hex; emailed to invitee\n  invitedBy  String // userId who sent the invite\n  expiresAt  DateTime\n  acceptedAt DateTime?\n  createdAt  DateTime  @default(now())\n\n  organization Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)\n  sender       User         @relation(\"OrgInviteSender\", fields: [invitedBy], references: [id], onDelete: Cascade)\n\n  @@index([orgId])\n  @@index([email])\n}\n\nmodel Session {\n  id          String    @id @default(uuid())\n  userId      String\n  refreshHash String    @unique\n  userAgent   String?\n  ipAddress   String?\n  expiresAt   DateTime\n  revokedAt   DateTime?\n  createdAt   DateTime  @default(now())\n\n  user User @relation(fields: [userId], references: [id], onDelete: Cascade)\n\n  @@index([userId])\n}\n\n// ── Secrets (encrypted blobs, keyed by user + name) ──────────\nmodel Secret {\n  id         String   @id @default(uuid())\n  userId     String\n  // Phase E8 — org tenancy. Nullable in the schema to keep legacy rows\n  // valid; new rows are required to set this via the requireOrg middleware.\n  orgId      String?\n  name       String // e.g. \"claude.apiKey\", \"ado.pat\", \"jira.token\", \"webhook.secret\"\n  ciphertext String // hex-encoded AES-256-GCM\n  iv         String // hex-encoded IV\n  authTag    String // hex-encoded auth tag\n  lastFour   String? // last 4 chars of plaintext for UI display\n  createdAt  DateTime @default(now())\n  updatedAt  DateTime @updatedAt\n\n  user User @relation(fields: [userId], references: [id], onDelete: Cascade)\n\n  @@unique([userId, name])\n  @@index([orgId])\n}\n\n// ── Integration configs (Claude, ADO, Jira) ──────────────────\nmodel Integration {\n  id              String    @id @default(uuid())\n  userId          String\n  // Phase E8 — see Secret.orgId note. Backfilled to the user's Solo org.\n  orgId           String?\n  type            String // 'claude' | 'ado' | 'jira'\n  config          String    @default(\"{}\") // JSON-encoded — see jsonField helpers\n  status          String    @default(\"unconfigured\") // unconfigured | valid | invalid\n  lastValidatedAt DateTime?\n  lastError       String?\n  createdAt       DateTime  @default(now())\n  updatedAt       DateTime  @updatedAt\n\n  user User @relation(fields: [userId], references: [id], onDelete: Cascade)\n\n  @@unique([userId, type])\n  @@index([orgId])\n}\n\n// ── Webhook delivery target ─────────────────────────────────\nmodel WebhookConfig {\n  id             String   @id @default(uuid())\n  userId         String\n  // Phase E8 — see Secret.orgId note.\n  orgId          String?\n  url            String\n  events         String // JSON-encoded string[] — see helpers in services. Postgres can use String[] directly.\n  enabled        Boolean  @default(true)\n  lastFourSecret String? // last 4 chars of signing secret for display\n  createdAt      DateTime @default(now())\n  updatedAt      DateTime @updatedAt\n\n  user       User              @relation(fields: [userId], references: [id], onDelete: Cascade)\n  deliveries WebhookDelivery[]\n\n  @@index([userId])\n  @@index([orgId])\n}\n\nmodel WebhookDelivery {\n  id           String   @id @default(uuid())\n  webhookId    String\n  event        String\n  payload      String   @default(\"{}\") // JSON-encoded\n  statusCode   Int?\n  responseBody String?\n  latencyMs    Int?\n  attempts     Int      @default(1)\n  succeeded    Boolean  @default(false)\n  error        String?\n  createdAt    DateTime @default(now())\n\n  webhook WebhookConfig @relation(fields: [webhookId], references: [id], onDelete: Cascade)\n\n  @@index([webhookId, createdAt])\n}\n\n// ── Notification channels & routing ─────────────────────────\nmodel NotificationChannel {\n  id              String    @id @default(uuid())\n  userId          String\n  // Phase E8 — see Secret.orgId note.\n  orgId           String?\n  type            String // 'email' | 'slack' | 'webhook'\n  target          String // email address, slack webhook URL, generic URL\n  verified        Boolean   @default(false)\n  lastTestAt      DateTime?\n  lastTestSuccess Boolean?\n  createdAt       DateTime  @default(now())\n  updatedAt       DateTime  @updatedAt\n\n  user   User                @relation(fields: [userId], references: [id], onDelete: Cascade)\n  routes NotificationRoute[]\n\n  @@index([userId])\n  @@index([orgId])\n}\n\nmodel NotificationRoute {\n  id        String @id @default(uuid())\n  channelId String\n  event     String // 'run.completed', 'run.failed', 'locator.blocked', 'governance.pr_ready', ...\n\n  channel NotificationChannel @relation(fields: [channelId], references: [id], onDelete: Cascade)\n\n  @@unique([channelId, event])\n}\n\n// ── Project / Run / TestCase domain ─────────────────────────\nmodel Project {\n  id                       String   @id @default(uuid())\n  userId                   String\n  // Phase E8 — multi-tenancy. The org this project belongs to.\n  // Nullable in the schema for backfill compatibility; the requireOrg\n  // middleware refuses creates/reads that don't carry an orgId.\n  orgId                    String?\n  name                     String\n  environment              String   @default(\"staging\")\n  framework                String   @default(\"playwright-pom\")\n  targetUrl                String?\n  // Free-form notes the user wants every AI agent to honour on this project.\n  // Prepended to every agent's system prompt via server/lib/promptCompose.\n  // Example: \"This app uses MUI date pickers — prefer aria-label='Choose date'\".\n  aiGuidance               String?\n  // Verifier-layer synonyms. JSON-encoded array of:\n  //   [{ canonical: \"A-Z\", variants: [\"A to Z\", \"AtoZ\"] },\n  //    { canonical: \"confirmation page\", variants: [\"Thank you for your order!\"] }]\n  // The deterministic `assertion_check` normaliser substitutes every variant\n  // occurrence with its canonical form before substring matching — so a\n  // declared assertion of \"A-Z\" matches a page rendering \"Name (A to Z)\".\n  // Populated by the \"Save as project synonym\" flow after a semantic-fallback\n  // rerun rescues a case. Editable by the operator in Settings → Claude.\n  assertionEquivalences    String?\n  // PAGE assertion sprint — per-project learned-page-identity store.\n  // Populated by the Conductor when a PAGE assertion matches (either via the\n  // deterministic 2-of-{role=2, text=1, url=1} quorum or via LLM semantic\n  // rescue when cold-start architect signals miss). Read by the page matcher\n  // to augment the architect's declared signals with previously-verified\n  // ones. Each atlas signal carries { source, verifiedCount, firstSeenAt } so\n  // unverified entries contribute at half weight and only promote to full\n  // weight after two independent runs corroborate them (strict corroboration\n  // trigger). Nullable — projects without an atlas run on architect signals\n  // alone. See server/services/agents/conductor.js for the recording hook\n  // and server/services/mcp.js#matchPageAssertion for the matcher.\n  pageAtlas                String?\n  // Which LLM provider runs the 7 agents for this project. Default 'claude'\n  // keeps existing projects working unchanged. 'gemini' routes via the\n  // Google Generative AI SDK with the same canonical message shape; see\n  // server/lib/providers/gemini.js for the Anthropic <-> Gemini translation.\n  aiProvider               String   @default(\"claude\") // 'claude' | 'gemini'\n  // Phase F (cost control) — execution mode for the Conductor pipeline.\n  //   'fast'     (default) — 12 turns/case, 1 conductor attempt, no Supervisor\n  //                          finalise pass, inline Critic on errors only.\n  //                          Suitable for daily iteration loops.\n  //   'thorough' — 22 turns/case, 2 conductor attempts + 1 Supervisor finalise\n  //                pass, periodic inline Critic every 5 turns.\n  //                Suitable for pre-release gate runs.\n  // The single biggest cost lever in the system — see Phase F PHASE_LOG for\n  // the 3.5M-token forensics that motivated this column.\n  execMode                 String   @default(\"fast\")\n  // Test users the QA team has authorised the agent to use for this project.\n  // JSON-encoded array of { name, email, password, notes? }. Injected into\n  // the Conductor's system prompt as \"## Available test users\". If a case\n  // requires a logged-in user and this list is empty, the agent must end the\n  // turn with \"BLOCKED: no credentials provided\" — fabricating credentials\n  // is a known failure mode (Phase D).\n  testCredentials          String?\n  // E2 — default auth fixture for SSO injection. Points to an AuthFixture.id.\n  // When set, the Conductor injects the fixture's storageState at session start\n  // so the browser context starts already authenticated.\n  defaultAuthFixtureId     String?\n  // Phase E3 — code-diff awareness. The repo + branch + provider let the\n  // codeDiffAnalyzer agent fetch the actual code change ahead of test\n  // generation, so the Architect can bias scenarios toward the surfaces\n  // a PR touches. PAT lives in the Secret vault keyed `<provider>.pat`.\n  // All three are nullable — diff-context is opt-in.\n  repoUrl                  String?\n  defaultBranch            String? // 'main' typically\n  gitProvider              String? // 'github' | 'gitlab' | 'azure'\n  // Phase E10.5 — Browser context configuration. Threaded into\n  // @playwright/mcp at session boot so the agent's browser matches the\n  // SUT's real-world conditions (auth, locale, geo, device, proxy).\n  // All nullable; absent fields fall back to MCP defaults.\n  // Sensitive bits (httpCredentials.password, extraHTTPHeaders) live here\n  // for v1 simplicity; future hardening moves them to the Secret vault.\n  contextViewport          String? // JSON {width, height} — overrides MCP default 1280x720\n  contextDevice            String? // e.g. 'iPhone 15' — Playwright device-emulation preset\n  contextLocale            String? // BCP-47 e.g. 'en-US', 'fr-FR' — injected via init-script\n  contextUserAgent         String? // override default UA string\n  contextColorScheme       String? // 'light' | 'dark' | 'no-preference' — via init-script matchMedia override\n  contextPermissions       String? // JSON string[] e.g. ['geolocation','clipboard-read','clipboard-write']\n  contextGeolocation       String? // JSON {latitude, longitude, accuracy?} — geo permission must be granted too\n  contextHttpCredentials   String? // JSON {username, password} for Basic/Digest auth via init-script Authorization header\n  contextExtraHeaders      String? // JSON {header: value} — injected via init-script fetch interceptor\n  contextIgnoreHttpsErrors Boolean  @default(false)\n  contextProxyServer       String? // 'http://host:port' or 'socks5://host:port'\n  contextProxyBypass       String? // comma-separated domains\n  // Phase E10.5 — Pre-registered dialog handler default. When true\n  // (default), the session boot script auto-accepts any window.alert /\n  // confirm / prompt that fires unexpectedly so the agent doesn't hang.\n  // Set to false on projects where a test explicitly validates dialog\n  // copy and needs to handle them manually.\n  autoAcceptDialogs        Boolean  @default(true)\n  // Phase H M1 — per-project override for the mechanical verdict layer.\n  // Null = use the QAAI_VERDICT_MODE env default. Captured per-run at\n  // Run.verdictMode and immutable for the duration of that run; switching\n  // verdict logic mid-suite produces incoherent reports.\n  verdictMode              String? // null | 'legacy' | 'mechanical_v1'\n  // Phase H+1 — Project-level \"known popups\" config. JSON array of records\n  // declaring popups that may appear on this project's site and should be\n  // dismissed defensively. Threaded into BOTH the Conductor's runtime\n  // prompt (so the live agent proactively dismisses them) AND the codegen\n  // prompt (so generated spec files include a beforeEach hook that\n  // dismisses them, surviving re-runs).\n  //\n  // Schema per record:\n  //   {\n  //     \"name\":       \"Cookie consent banner\",          // human-readable label\n  //     \"matcher\":    { \"strategy\": \"role\"|\"text\"|\"testId\"|\"css\"|\"label\",\n  //                     \"value\":    \"<selector|text|regex>\",\n  //                     \"role\":     \"<optional ARIA role>\" },\n  //     \"scope\":      \"global\" | \"first-page-load\" | \"after-auth\",\n  //     \"afterDismiss\": \"wait-hidden\" | \"reload\" | null\n  //   }\n  //\n  // Flexible by design — no hardcoded site assumptions. Operators\n  // declare popups for their project once; every spec inherits the\n  // dismissal logic. Null/empty = no project-level popups; specs still\n  // get the defensive-wrapping codegen behaviour for ad-hoc popups.\n  knownPopups              String?\n  // \"Open in VS Code\" — absolute folder path on the operator's machine where\n  // the generated suite for this project is copied and opened. Local\n  // single-tenant convenience: the server writes the run's files here and\n  // launches `code <path>`. Nullable; the UI prompts for it on first use.\n  vscodeWorkspacePath      String?\n  createdAt                DateTime @default(now())\n  updatedAt                DateTime @updatedAt\n\n  user                User                   @relation(fields: [userId], references: [id], onDelete: Cascade)\n  requirements        Requirement[]\n  testCases           TestCase[]\n  scenarios           TestScenario[]\n  runs                Run[]\n  documents           Document[]\n  locators            KnowledgeBaseLocator[]\n  prs                 GovernancePR[]\n  blockers            BlockedItem[]\n  agentRuns           AgentRun[]\n  discrepancies       Discrepancy[]\n  sprints             Sprint[]\n  diffContexts        DiffContext[]\n  downloads           Download[]\n  failurePatterns     FailurePattern[]\n  authFixtures        AuthFixture[]\n  calibrations        Calibration[]\n  scenarioGenerations ScenarioGeneration[]\n  testDataSets        TestDataSet[]\n  requirementClauses  RequirementClause[]\n  authProfiles        AuthProfile[]\n\n  @@index([userId])\n  @@index([orgId])\n}\n\n// ── Download (Phase E10.5) ──────────────────────────────────\n// Captured by the downloadWatcher service. One row per file the\n// browser downloaded during a run. The Conductor's `assertion_check`\n// can verify downloads via the linked RunResult, and Reports surfaces\n// them in the run detail pane.\n//\n// `path` is the on-disk location under playwright/test-results/downloads/.\n// We keep paths absolute so artifact-serving routes don't have to\n// reconstruct them; the deleter on Run cleanup removes both row + file.\nmodel Download {\n  id                String   @id @default(uuid())\n  projectId         String\n  runResultId       String?\n  suggestedFilename String // filename the page suggested (Content-Disposition)\n  storedFilename    String // actual on-disk name (uuid-prefixed to avoid clobbering)\n  path              String // absolute path on the QAAI server\n  sizeBytes         Int      @default(0)\n  mimeType          String?\n  capturedAt        DateTime @default(now())\n\n  project   Project    @relation(fields: [projectId], references: [id], onDelete: Cascade)\n  runResult RunResult? @relation(fields: [runResultId], references: [id], onDelete: SetNull)\n\n  @@index([projectId, capturedAt])\n  @@index([runResultId])\n}\n\n// ── DiffContext (Phase E3) ──────────────────────────────────\n// One row per fetched PR/branch/commit diff. The Architect reads the most\n// recent DiffContext for a project (filtered by sprint when set) and uses\n// it to bias scenario generation. Stale rows accumulate by design — they\n// double as a history of \"which changes the team tested against\".\nmodel DiffContext {\n  id             String   @id @default(uuid())\n  projectId      String\n  sprintId       String? // when fetched in a sprint, scoped to it\n  // Free-form identifier: PR number (\"#123\"), branch name, commit SHA, or\n  // human label. Used in the UI; not a unique key.\n  ref            String\n  baseRef        String // the comparison base — usually defaultBranch\n  // JSON-encoded array of { path, additions, deletions, status }.\n  changedFiles   String\n  // JSON-encoded array of derived module names (path-segment + fuzzy).\n  changedModules String\n  // Optional Claude-generated 2-sentence narrative.\n  summary        String?\n  fetchedAt      DateTime @default(now())\n\n  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)\n\n  @@index([projectId, sprintId])\n  @@index([projectId, fetchedAt])\n}\n\n// ── Sprint (B3 hybrid: per-project release cycle container) ──\n// Holds Docs/Requirements/Runs/Blockers/PRs for one release. TestCases\n// stay PROJECT-level (smoke tests reused across sprints) and reference\n// the sprints they ran in via the SprintTestCase join. See BUILD_PLAN.md\n// \"Phase B\" for the three options considered; B3 is what shipped.\nmodel Sprint {\n  id            String    @id @default(uuid())\n  projectId     String\n  name          String\n  // 'planning' | 'in_progress' | 'completed' | 'archived'. Completed sprints\n  // are read-only at the route layer (writes refuse with SPRINT_LOCKED).\n  lifecycle     String    @default(\"in_progress\")\n  // Phase B+: sprint-scoped operator guidance, stacked on top of\n  // Project.aiGuidance via promptCompose.joinGuidance. Example:\n  // \"this sprint focuses on checkout — bias scenarios toward payments flows\".\n  aiGuidance    String?\n  // Planned end date for the sprint — drives the \"days-to-cut\" indicator\n  // on the Overview sprint-health tile and the comparison view summary.\n  // Nullable: legacy sprints + sprints without a planned end keep working.\n  expectedEndAt DateTime?\n  createdAt     DateTime  @default(now())\n  updatedAt     DateTime  @updatedAt\n\n  project Project          @relation(fields: [projectId], references: [id], onDelete: Cascade)\n  cases   SprintTestCase[]\n\n  @@index([projectId])\n}\n\n// ── Calibration (E4 — Calibrator MVP) ──────────────────────────────────────\nmodel Calibration {\n  id           String            @id @default(cuid())\n  projectId    String\n  project      Project           @relation(fields: [projectId], references: [id], onDelete: Cascade)\n  status       String            @default(\"running\")\n  startUrl     String\n  pagesCount   Int               @default(0)\n  errorMessage String?\n  createdAt    DateTime          @default(now())\n  completedAt  DateTime?\n  pages        CalibrationPage[]\n\n  // P3 — role-aware, module-scoped, versioned atlas. The unit of work is the\n  // slice (projectId, module, authProfileId, version). All nullable/defaulted so\n  // a legacy whole-app calibration (module=null, authProfileId=null, version=1)\n  // is unchanged. module = the Focus module (\"pim\", \"checkout\"); authProfileId =\n  // the AuthFixture the crawl ran AS (null = unauthenticated/default identity).\n  module           String?\n  authProfileId    String?\n  version          Int       @default(1)\n  isCurrent        Boolean   @default(true)\n  atlasFingerprint String? // aggregate of page snapshotHashes — the drift key\n  staleAt          DateTime? // freshness horizon; past it, getCalibrationAtlas reports 'stale'\n\n  @@index([projectId])\n  @@index([projectId, module, authProfileId, isCurrent])\n}\n\nmodel CalibrationPage {\n  id               String      @id @default(cuid())\n  calibrationId    String\n  calibration      Calibration @relation(fields: [calibrationId], references: [id], onDelete: Cascade)\n  url              String\n  normalizedUrl    String\n  pageRole         String?\n  elementsJson     String\n  // Visible page TEXT (headings, labels, column headers, static copy) as a\n  // JSON string[] — distinct from elementsJson, which only holds INTERACTIVE\n  // controls. This is the ground truth a TEXT/PAGE assertion is checked\n  // against: it lets the Architect see the real labels a page shows and lets\n  // groundAssertions() down-tier any expectedText that no calibrated page\n  // actually displays. Nullable so pre-existing rows (interactive-only) keep\n  // working; null = \"text not captured for this page\".\n  textCorpus       String?\n  snapshotHash     String?\n  // P3 — typed capabilities for this page: CapabilityRecord[] (see\n  // server/lib/capabilityVocabulary.js). Each record carries the capability type,\n  // its supported operations, and Node-extracted VERIFIED-selector evidence — the\n  // substrate the Architect/TestData/BDD layers compile typed steps from (never\n  // free prose). Nullable so legacy pages (no capabilities) keep working.\n  capabilitiesJson String?\n  capturedAt       DateTime    @default(now())\n\n  @@index([calibrationId])\n}\n\n// Join: which TestCases were RUN inside which sprints. Populated when a\n// Run starts (one row per scenario.case in the run). Used by the Sprint\n// comparison view + carry-forward features in Phase B+.\nmodel SprintTestCase {\n  id         String   @id @default(uuid())\n  sprintId   String\n  testCaseId String\n  createdAt  DateTime @default(now())\n\n  sprint   Sprint   @relation(fields: [sprintId], references: [id], onDelete: Cascade)\n  testCase TestCase @relation(fields: [testCaseId], references: [id], onDelete: Cascade)\n\n  @@unique([sprintId, testCaseId])\n  @@index([testCaseId])\n}\n\nmodel Document {\n  id         String   @id @default(uuid())\n  projectId  String\n  sprintId   String?\n  name       String\n  mimeType   String?\n  sizeBytes  Int\n  content    String\n  category   String   @default(\"other\") // 'brd' | 'user-stories' | 'release-notes' | 'api-spec' | 'other'\n  uploadedAt DateTime @default(now())\n\n  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)\n\n  @@index([projectId])\n  @@index([sprintId])\n}\n\nmodel Requirement {\n  id               String   @id @default(uuid())\n  projectId        String\n  sprintId         String?\n  sourceType       String // 'ado' | 'jira' | 'upload' | 'manual'\n  sourceIdentifier String?\n  title            String?\n  content          String\n  category         String   @default(\"other\") // mirrors Document.category\n  pulledAt         DateTime @default(now())\n\n  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)\n\n  @@index([projectId])\n  @@index([sprintId])\n}\n\n// ── TestDataSet (Round A — the \"test data\" input) ───────────\n// Structured test DATA uploaded as .xlsx/.csv: the concrete inputs QA drives\n// the app with (valid / invalid / boundary / locale rows). Unlike Document,\n// which flattens everything to prose, this stays STRUCTURED (sheets → headers\n// → rows) because the rows/columns ARE the value. The dataMapper agent binds\n// columns to user-story/scenario step fields (mappingJson); the Architect then\n// generates data-aware cases and codegen emits data-driven specs.\nmodel TestDataSet {\n  id          String   @id @default(uuid())\n  projectId   String\n  sprintId    String?\n  name        String\n  // JSON: { sheets: [{ name, headers: string[], rows: object[] }], rowCount }.\n  // Kept verbatim from the parser so no structure is lost en route to mapping.\n  sheetsJson  String\n  // JSON mapping produced by the dataMapper agent (column → step field, row\n  // classification). Null until mapping runs; user-editable in the UI.\n  mappingJson String?\n  rowCount    Int      @default(0)\n  uploadedAt  DateTime @default(now())\n\n  project  Project           @relation(fields: [projectId], references: [id], onDelete: Cascade)\n  mappings TestDataMapping[]\n\n  @@index([projectId])\n  @@index([sprintId])\n}\n\n// ── TestDataMapping (Enterprise Mode P4a — the approval ledger) ──────────────\n// An IMMUTABLE, versioned snapshot of an APPROVED column→field mapping. The\n// editable draft lives on TestDataSet.mappingJson; approving SNAPSHOTS it here as\n// a frozen row (status 'approved'); changing an approved mapping requires a NEW\n// version (the prior 'approved' row flips to 'superseded'). Generation pins a case\n// to a specific (mappingId, version); run/export resolve by that pin, so an old\n// case never silently consumes a newer approved mapping. See ENTERPRISE_MODE.md → \"P4\".\nmodel TestDataMapping {\n  id               String    @id @default(uuid())\n  testDataSetId    String\n  projectId        String\n  version          Int // monotonic per testDataSetId\n  status           String    @default(\"approved\") // approved | rejected | superseded\n  mappingJson      String // FROZEN snapshot of the draft at approval time\n  verificationJson String? // testDataApproval.verifyMapping report captured at approval\n  approvalNote     String? // required when approving over a warning finding (override reason)\n  createdBy        String? // who authored/last-edited the draft (RBAC attribution, P9)\n  approvedBy       String? // maker-checker attribution (P9 enforces approvedBy != createdBy)\n  approvedAt       DateTime?\n  rejectedReason   String?\n  createdAt        DateTime  @default(now())\n\n  testDataSet TestDataSet @relation(fields: [testDataSetId], references: [id], onDelete: Cascade)\n\n  @@unique([testDataSetId, version])\n  @@index([projectId])\n  @@index([testDataSetId, status])\n}\n\n// ── RequirementClause (Enterprise Mode P2 — the requirements oracle) ────────\n// An ATOMIC, independently-verifiable behaviour extracted from a source doc.\n// Distinct from Requirement (which is a coarse source-system item: ADO/Jira/\n// upload). The LLM proposes candidate clauses; Node owns the content-hash id,\n// verifies the excerpt is a verbatim source substring, dedupes, and builds the\n// RTM. This is the INDEPENDENT oracle: a `must` assertion's expected value must\n// trace to one of these, never to the live app. See ENTERPRISE_MODE.md → \"P2\".\nmodel RequirementClause {\n  // Content-addressed: \"REQ-\" + sha1(sourceType + \"\\n\" + normalize(excerpt)).\n  // Deterministic across re-uploads of the same text → stable IDs, no random\n  // LLM-invented IDs. NOT @default(uuid) — the caller supplies the hash id.\n  id                  String    @id\n  projectId           String\n  sprintId            String?\n  sourceType          String // 'BRD' | 'USER_STORY' | 'RELEASE_NOTE'\n  sourceDocId         String?\n  excerpt             String // verbatim span from the source document (audit proof)\n  spanStart           Int?\n  spanEnd             Int?\n  behaviourText       String // the atomic, testable statement (LLM-phrased, for authoring)\n  // JSON array of {sourceType, sourceDocId, spanStart, spanEnd} for the OTHER\n  // sources that merged into this clause (dedupe across BRD/US/RN).\n  sourcesJson         String?\n  // RTM disposition. 'covered' is DERIVED (>= 1 case refs this clause); the\n  // other two are explicit human dispositions that REQUIRE dispositionReason.\n  coverageDisposition String    @default(\"uncovered\") // covered | uncovered | manually_excluded | not_automatable\n  dispositionReason   String?\n  dispositionBy       String? // RBAC attribution (P9)\n  dispositionAt       DateTime?\n  createdAt           DateTime  @default(now())\n\n  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)\n\n  @@index([projectId])\n  @@index([sprintId])\n}\n\nmodel Discrepancy {\n  id         String    @id @default(uuid())\n  projectId  String\n  kind       String // 'in_brd_not_in_release' | 'in_release_not_in_brd' | 'spec_mismatch' | 'requirement_conflict' | 'requirement_uncovered'\n  summary    String\n  detail     String\n  severity   String    @default(\"info\") // 'info' | 'warning' | 'critical'\n  resolved   Boolean   @default(false)\n  resolvedAt DateTime?\n  createdAt  DateTime  @default(now())\n\n  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)\n\n  @@index([projectId, resolved])\n}\n\nmodel TestScenario {\n  id           String   @id @default(uuid())\n  projectId    String\n  name         String\n  module       String\n  priority     String // 'P0' | 'P1' | 'P2' | 'P3'\n  category     String // 'positive' | 'negative' | 'edge' | 'boundary' | 'empty' | 'e2e'\n  rationale    String\n  dependencyOn String? // JSON-encoded array of scenario IDs\n  source       String   @default(\"agent\") // 'agent' | 'manual'\n  impacted     Boolean  @default(false) // smart-selection: this scenario is affected by current release notes\n  impactReason String? // why it was marked impacted\n  // Versioning — which generation batch this scenario belongs to. A\n  // regenerate creates a NEW ScenarioGeneration and keeps prior scenarios\n  // (no destructive wipe), so the user can browse/select past generations.\n  // Nullable for legacy rows until the backfill migration stamps them.\n  generationId String?\n  createdAt    DateTime @default(now())\n  updatedAt    DateTime @updatedAt\n\n  project    Project             @relation(fields: [projectId], references: [id], onDelete: Cascade)\n  cases      TestCase[]\n  generation ScenarioGeneration? @relation(fields: [generationId], references: [id], onDelete: SetNull)\n\n  @@index([projectId, priority])\n  @@index([generationId])\n}\n\n// Versioning — one row per \"Generate scenarios\" batch for a project. The\n// current generation (isCurrent=true, exactly one per project) is what every\n// page shows by default; selecting a past generation re-skins Test Cases,\n// Overview, and Reports to that batch's scenarios + the runs executed against\n// it. Replaces the old destructive deleteMany-on-regenerate behaviour.\nmodel ScenarioGeneration {\n  id            String   @id @default(uuid())\n  projectId     String\n  version       Int // per-project incrementing version (1, 2, 3…)\n  label         String? // short human summary of the generate config (depth/focus)\n  isCurrent     Boolean  @default(true)\n  scenarioCount Int      @default(0)\n  caseCount     Int      @default(0)\n  createdAt     DateTime @default(now())\n\n  project   Project        @relation(fields: [projectId], references: [id], onDelete: Cascade)\n  scenarios TestScenario[]\n  cases     TestCase[]\n  runs      Run[]\n\n  @@unique([projectId, version])\n  @@index([projectId, isCurrent])\n}\n\nmodel TestCase {\n  id                   String    @id @default(uuid())\n  projectId            String\n  scenarioId           String?\n  // Back-relation for the SprintTestCase join. No own FK; this is just so\n  // Prisma can navigate `testCase.sprintTestCases`.\n  name                 String\n  type                 String // 'smoke' | 'regression' | 'functional' | 'security' | 'boundary' | 'integration'\n  module               String\n  confidence           Int\n  // Approval/lifecycle state ONLY. Do NOT overload this with execution\n  // results — pass/fail/blocked/skipped belong on RunResult per-run. Derive\n  // execution status by reading the latest RunResult for this test case\n  // (see services/runs.js#withLatestResult).\n  status               String    @default(\"pending\") // pending | approved | rejected | running\n  assertions           String\n  steps                String? // JSON-encoded array of { order, action, target?, value?, expected? }\n  specCode             String? // generated Playwright spec code\n  // Free-form notes from the user that the Conductor / Critic / Supervisor\n  // honour for this specific case on every future run. Example: \"Always wait\n  // for the loading spinner to disappear before clicking submit.\"\n  userGuidance         String?\n  // Case-level dependency graph. JSON-encoded array of TestCase IDs that\n  // MUST have passed (or at least executed) before this case is run.\n  // Architect emits this from the requirements (\"Verify checkout\" depends\n  // on \"Register user\" + \"Add to cart\"); the runs service topologically\n  // sorts the input testCaseIds and auto-includes missing prerequisites.\n  // Null / empty array = standalone case (the common case).\n  dependsOnIds         String?\n  // Cross-case data chaining (sharedData sprint, 2026-05-30).\n  //   producesData — JSON array of key names this case extracts at runtime\n  //                  via the browser_extract_data tool (e.g. [\"trackingId\"]).\n  //                  Architect declares; conductor honours.\n  //   requiresData — JSON array of key names this case CONSUMES from\n  //                  upstream cases (via Run.sharedData). The conductor\n  //                  filters Run.sharedData by these keys and injects only\n  //                  the requested subset into the per-case user message\n  //                  (not the system prompt — preserves prompt cache).\n  // P0-17 architect output validator rejects requiresData keys that no\n  // upstream case (via dependsOnIds) produces.\n  producesData         String?\n  requiresData         String?\n  // TestData Round B — data-driven (matrix) execution binding. JSON-encoded:\n  //   { sheet, rowSelector?, columnToField?, expectedColumn?, rowClassColumn? }\n  // Architect emits it when a scenario maps to an uploaded data sheet; the\n  // conductor expands the case to run ONCE PER ROW of that sheet, substituting\n  // the row's {{token}} values into steps/assertions. Null = not data-driven →\n  // the case runs exactly once (the common case; behaviour unchanged). When\n  // the binding omits columnToField/expectedColumn, the run resolves them from\n  // the project's TestDataSet mapping, so a bare { sheet } binding is enough.\n  dataBindingJson      String?\n  // Enterprise Mode P2 — traceability to the requirements oracle. JSON array of\n  // RequirementClause ids this case verifies (>= 1 for an automatable case once\n  // the oracle is wired into generation). The \"covered\" axis of the RTM is\n  // derived from these refs. Null = not yet traced (pre-P2-integration cases).\n  requirementRefs      String?\n  // Enterprise Mode P3d — the bound capability-operation plan for this case.\n  // JSON: { status: 'complete'|'incomplete', operations: [{operation, capabilityRef,\n  // params}], dropped: [{operation, reason, detail}] }. The Architect proposes\n  // operations from the module's verified capability menu; Node disposes\n  // (operationPlan.markCaseOperations) — invalid/foreign ops are dropped and the\n  // case is marked 'incomplete'. The BDD package-export gate consumes status +\n  // dropped to refuse shipping a complete-looking feature for an incomplete case;\n  // the BDD bridge consumes operations. Null = no plan (legacy / whole-project /\n  // manual). Populated only on module-scoped generation once capabilities exist.\n  operationsJson       String?\n  // Enterprise Mode P4b — the declared business IDENTITY this case runs as\n  // (references an AuthProfile.name). Null = legacy default-fixture behavior,\n  // unchanged. Selects the atlas slice the case grounds against (P3b pickSlice\n  // wrong-role firewall) and how run/export authenticates (AuthProfile.disposition).\n  authProfile          String?\n  // Phase D — Manual vs Automation classifier. The Architect labels each\n  // case during generation. \"automatable\" (default) is run by the agent\n  // end-to-end. \"manual\" is reserved for cases that genuinely cannot be\n  // browser-automated (legal copy review, aesthetic judgment, real\n  // payment, accessibility audit, multi-device coordination). MOST\n  // half-manual cases are handled at the STEP level via the synthetic\n  // human_input tool call — only fully-unautomatable cases land here.\n  automatability       String    @default(\"automatable\")\n  automatabilityReason String?\n  // AI-generated step-by-step guide for the tester to perform a manual\n  // case by hand. Lazily generated the first time the user expands the\n  // case on the Manual tab; cached afterward.\n  manualGuide          String?\n  // Timestamp when the tester marked the manual case complete. Used to\n  // unblock downstream automation cases that depend on it.\n  manualCompletedAt    DateTime?\n  // Phase H M1 — structured assertion records emitted natively by the\n  // Architect (replaces post-hoc parsing of the free-form `assertions`\n  // prose). JSON-encoded array of records:\n  //   { id, type, payload, targetUrl?, checkAt, parseFailed?, source }\n  // - id: stable UUID assigned at TC creation; persisted; same across all\n  //   runs of this TC. Cross-TC-regeneration produces new IDs (different\n  //   TC row, different test logically).\n  // - type: 'TEXT' | 'URL' | 'ROLE' | 'DOWNLOAD' | 'FORBIDDEN_TEXT' |\n  //         'FORBIDDEN_ROLE' | 'EVALUATE'.\n  // - payload: shape varies by type (e.g. { expectedText: '...' }).\n  // - targetUrl: normalized path the assertion expects; absence means\n  //   the assertion is checkable on any page.\n  // - checkAt: 'end' (default; ratifiable post-loop against final\n  //   snapshot) | 'transient' (must be checked mid-loop; post-loop\n  //   ratification of a missed transient → uncheckable(transient_window_missed)).\n  // - parseFailed: true when the legacy LLM migration could not decompose\n  //   the prose into a typed record; routes to\n  //   uncheckable(declared_assertion_unparseable) at runtime.\n  // - source: 'architect' | 'calibrator_grounded' (Phase 3) | 'historical_backfill'.\n  // Free-form `assertions` field retained ONLY for human-readable summary\n  // on the Test Cases page — not source of truth for verification.\n  declaredAssertions   String?\n  // E3 — business risk tier. Drives the release recommendation engine:\n  // any P0 failure → unconditional NO_GO regardless of overall pass rate.\n  // Architect assigns at generation time based on module/keyword classification.\n  // P1 default: existing cases unaffected until Architect re-classifies them.\n  businessRisk         String    @default(\"P1\") // P0 | P1 | P2\n  // Versioning — generation batch this case belongs to (mirrors its scenario).\n  generationId         String?\n  createdAt            DateTime  @default(now())\n  updatedAt            DateTime  @updatedAt\n\n  project         Project             @relation(fields: [projectId], references: [id], onDelete: Cascade)\n  scenario        TestScenario?       @relation(fields: [scenarioId], references: [id], onDelete: SetNull)\n  generation      ScenarioGeneration? @relation(fields: [generationId], references: [id], onDelete: SetNull)\n  results         RunResult[]\n  // Back-relations for the SetNull FKs declared on GovernancePR / BlockedItem.\n  // Without these, deleting a TestCase orphaned PRs and blockers by leaving\n  // testCaseId pointing at a non-existent row, contaminating dashboard counts.\n  prs             GovernancePR[]\n  blockers        BlockedItem[]\n  sprintTestCases SprintTestCase[]\n\n  @@index([projectId, status])\n  @@index([scenarioId])\n}\n\nmodel Run {\n  id           String    @id @default(uuid())\n  userId       String\n  projectId    String\n  // FK to Sprint when the run was tagged at start (B3). Stays NULL for\n  // legacy runs (pre-Sprint) and runs started without a current sprint.\n  sprintId     String?\n  sprintName   String\n  status       String    @default(\"running\") // running | completed | failed | cancelled\n  // Counters denormalised from RunResult for fast list rendering. Keep in\n  // sync via recomputeRunCounters() in services/runs.js — never mutate one\n  // of the four without recomputing all four from RunResult rows.\n  // `blocked` and `skipped` mean different things — `blocked` is an\n  // environmental/browser failure that prevented assertions from running,\n  // `skipped` is `test.skip()` / `--grep` deselection that the engineer\n  // intentionally excluded. Conflating them mis-leads release decisions.\n  passed       Int       @default(0)\n  failed       Int       @default(0)\n  blocked      Int       @default(0)\n  skipped      Int       @default(0)\n  // Phase H+2 (P0-9) — needs_human is a peer of pass/fail/blocked/skipped,\n  // emitted by the mechanical verdict layer when execution completed but\n  // verification couldn't be evaluated (e.g., all assertions uncheckable\n  // because the agent never reached the target page, or assertion text\n  // was ungrounded). Hidden from Run counters before this column existed,\n  // producing \"dashboard says 12 cases ran but the DB has 31 RunResults\"\n  // — the demo-killer caught 2026-05-29.\n  needsHuman   Int       @default(0)\n  // Cross-case data chaining (sharedData sprint, 2026-05-30).\n  // JSON object — accumulated key/value pairs extracted via the\n  // browser_extract_data tool. Values are primitive (string/number/boolean\n  // only — keep the bag flat). Read by downstream cases that declare\n  // requiresData. Persistence semantics: every successful extraction does\n  // a read-modify-write merge against this column. Existing keys can be\n  // overwritten (last write wins) — the architect's P0-17 grounding rule\n  // is what prevents conflicting producers in practice.\n  sharedData   String?\n  startedAt    DateTime  @default(now())\n  completedAt  DateTime?\n  // Phase H M1 — captured at run-start from Project.verdictMode ?? env\n  // QAAI_VERDICT_MODE. Immutable for the duration of this run; the\n  // Conductor reads this value per-case and dispatches to the legacy\n  // or mechanical verdict pipeline accordingly. Mid-run env-var flips\n  // do NOT affect in-flight runs — coherent reports require a single\n  // verdict logic for the whole suite.\n  verdictMode  String    @default(\"legacy\") // 'legacy' | 'mechanical_v1'\n  // Verifier mode for THIS run. 'deterministic' (default) uses only\n  // _checkAssertionOnce's normalised substring/role/url match.\n  // 'semantic_fallback' adds a single LLM call on each deterministic miss\n  // — the verifier asks Claude \"does this snapshot satisfy the assertion?\"\n  // and records source='semantic_fallback' on rescued outcomes. Used by\n  // the Blocked-page \"Rerun with AI verification\" flow. Immutable for the\n  // duration of the run (same coherence rule as verdictMode).\n  verifierMode String    @default(\"deterministic\") // 'deterministic' | 'semantic_fallback'\n  // Versioning — which scenario generation was current when this run started.\n  // Lets Reports/Overview filter runs to the selected generation. Stamped at\n  // run-start; null for legacy runs until backfilled.\n  generationId String?\n  config       String? // JSON-encoded\n\n  user       User                @relation(fields: [userId], references: [id], onDelete: Cascade)\n  project    Project             @relation(fields: [projectId], references: [id], onDelete: Cascade)\n  generation ScenarioGeneration? @relation(fields: [generationId], references: [id], onDelete: SetNull)\n  results    RunResult[]\n\n  @@index([userId, projectId])\n  @@index([sprintId])\n}\n\nmodel RunResult {\n  id                       String   @id @default(uuid())\n  runId                    String\n  testCaseId               String\n  status                   String // pass | fail | blocked | skipped\n  durationMs               Int?\n  error                    String?\n  screenshots              String   @default(\"[]\") // JSON-encoded string[]. Postgres can use String[].\n  video                    String?\n  trace                    String?\n  networkLog               String? // JSON-encoded array of {url, method, status, ms}\n  domSnapshots             String? // JSON-encoded array of {step, html}\n  // Reporter agent output\n  rcaWhat                  String?\n  rcaWhy                   String?\n  rcaFix                   String?\n  rcaClass                 String? // 'locator' | 'data' | 'timing' | 'backend' | 'env' | 'unknown'\n  rcaConfidence            Int? // 0-100\n  ticketId                 String? // external Jira/ADO id, e.g. \"ACME-123\" or \"9876\"\n  ticketUrl                String?\n  // Conversational follow-ups on this failure. JSON-encoded array of\n  // { role: 'user' | 'assistant', content: string, ts: string-ISO }.\n  // Populated by POST /runs/:r/results/:res/chat. Lives on the result so\n  // every result gets its own thread (no cross-test bleed).\n  chatHistory              String?\n  // Phase E4 — visual regression. baselineScreenshot is the served URL\n  // ('/artifacts/...') of the first-pass screenshot kept as the canonical\n  // look. visualVerdict / visualDiffSummary record the last visualCritic\n  // pass when one ran for this result.\n  baselineScreenshot       String?\n  visualVerdict            String? // 'pass' | 'fail' | 'inconclusive'\n  visualDiffSummary        String? // free-form 1-3 sentence narration\n  visualDiffs              String? // JSON array of {region, before, after, severity}\n  // Per-step verdicts (Bug B fix). JSON-encoded array of\n  // { index, status: pass|fail|blocked|skipped|pending, error? }.\n  // Nullable so legacy rows (before this column existed) survive untouched.\n  stepResults              String?\n  // Phase H Stage 0.5 — rich per-turn telemetry written to a gzipped file\n  // (`playwright/telemetry/<runId>/<runResultId>.json.gz`). Holds full\n  // uncapped snapshots, per-turn token usage, elapsed-ms, the assistant's\n  // text output verbatim, and stability-iteration counts. This column\n  // stores the absolute path on the QAAI server; the file is what Stage 2's\n  // replay harness will read. Nullable so legacy rows + early-Phase-H runs\n  // without telemetry remain valid.\n  richTraceFile            String?\n  // Phase H Stage 1.5 — assertion-gate observation in SOFT-FAIL mode.\n  //\n  // The gate's case-level rule: status='pass' + ZERO assertion_check calls\n  // AND at least one declared assertion → would-reject.\n  // In soft-fail mode the gate ONLY records its decision; it does NOT\n  // mutate status. The persisted fields are what the eventual flip-to-\n  // hard-reject decision rests on (the WS log entry evaporates with\n  // subscribers).\n  //\n  // assertionGateReason carries the per-assertion breakdown EVEN when\n  // the case-level gate didn't fire — e.g. \"3 declared, 1 unchecked:\n  // 'user lands on dashboard'\". That gives end-of-stage analysis both\n  // signals (case-level + per-assertion) so the flip threshold can be\n  // picked from observed data rather than pre-committed to a granularity.\n  assertionGateWouldReject Boolean  @default(false)\n  assertionGateReason      String?\n  // Phase H M1 — mechanical verdict layer columns. All additive; legacy\n  // rows default to verdictVersion='legacy' and are never mutated (per\n  // [[preserve-trial-data]] — the trial-run history is the UI fixture set).\n  //\n  // verdictVersion: 'legacy' (status column was computed by pre-M4 logic,\n  //   including agent's self-reported final_verdict) | 'mechanical_v1'\n  //   (status was computed by computeVerdict() from recorded facts).\n  // verdictMode: captured at Run.verdictMode start; mirrors here for\n  //   per-RunResult queryability and immutability.\n  // agentClaimedVerdict: the verdict the agent passed to final_verdict\n  //   (or null if it never called the tool). Recorded for telemetry but\n  //   does NOT influence status under mechanical_v1.\n  // flipDirection: computed at write time from (agentClaimedVerdict, status).\n  //   'FAIL_TO_PASS' | 'FAIL_TO_NEEDS_HUMAN' | 'PASS_TO_FAIL' |\n  //   'PASS_TO_NEEDS_HUMAN' | 'NEEDS_HUMAN_TO_FAIL' | 'NEEDS_HUMAN_TO_PASS'\n  //   | 'OTHER' | null (when agent and mechanical agreed).\n  //   Drives the disagreement-rate dashboard metric.\n  // assertionCheckResults: JSON array of every assertion_check call's\n  //   outcome for this case. Each entry:\n  //   { assertionId, outcome: 'matched'|'not_matched'|'uncheckable',\n  //     reason, evidence?, source: 'agent'|'post_loop', ts }.\n  //   Source of truth that computeVerdict() reads.\n  // mechanicalVerdictReason: the `reason` string from computeVerdict()\n  //   (e.g. 'assertion_not_matched', 'assertion_uncheckable',\n  //   'no_assertions_declared', 'turn_ceiling'). Null when status='pass'.\n  verdictVersion           String   @default(\"legacy\")\n  verdictMode              String   @default(\"legacy\")\n  agentClaimedVerdict      String?\n  flipDirection            String?\n  assertionCheckResults    String?\n  mechanicalVerdictReason  String?\n  // E0 — structured blocked-reason attribution. One of:\n  // selector_not_found | selector_quarantined | auth_required | session_expired |\n  // page_not_reached | unexpected_modal | assertion_uncheckable | agent_loop |\n  // env_config | multi_tab_required | iframe_required | failed_prereq | unknown\n  // Null for non-blocked statuses. Enables per-reason improvement measurement.\n  // Enterprise Mode P5 added `failed_prereq`: a dependent case the conductor did\n  // NOT execute because a prerequisite (via TestCase.dependsOnIds) did not pass.\n  // It is its OWN reason — visibly distinct from app-fail / script-fail / the\n  // environmental blocked reasons above — so Reports never mislabels a gated case\n  // as an app failure. See server/services/dependencyGraph.js.\n  blockedReason            String?\n  // Enterprise Mode P5 — EVIDENCE INHERITANCE for a failed_prereq block. When a\n  // dependent is gated, its result points at the EXACT prerequisite that caused\n  // it, so Reports + evidence bundles answer \"blocked by what?\" without manual\n  // reconstruction. All null for normally-executed cases (additive, inert until\n  // the P9 flag enforces gating).\n  //   blockedByTestCaseId  — the failed/blocked prerequisite TestCase.id\n  //   blockedByRunResultId — that prerequisite's RunResult.id in THIS run (if known)\n  //   blockedByReason      — the prerequisite's own outcome (e.g. 'fail',\n  //                          'blocked:selector_not_found') — the root cause\n  //   dependencyPath       — JSON [{id,name,status}] root-cause-first chain for\n  //                          multi-hop chains (A fail → B → C shows [A,B] on C)\n  blockedByTestCaseId      String?\n  blockedByRunResultId     String?\n  blockedByReason          String?\n  dependencyPath           String?\n  // Enterprise Mode P6 — the ReplayIR pinned to THIS result. JSON envelope:\n  // { ir, complete, gaps, emittedAt, emitterVersion }. `ir` is the frozen ReplayIR\n  // (server/services/codegen/adapters/frameworkAdapter.js), mechanically emitted from\n  // the recorded MCP trace + declared assertions + recorded assertion_check outcomes +\n  // this result's verdict. `complete:false` + `gaps` = trace evidence the emitter\n  // REFUSED to fabricate → the export lane treats the case as unsupported (never\n  // silently falls back to AI-written code). Additive nullable; emission NEVER breaks\n  // the run (failure → null + logged). P7 reads THIS column (one result → one IR,\n  // verdict/data-row/auth/cause all attached), never a \"latest generated IR\".\n  replayIrJson             String?\n  // TestData Round B — per-row (matrix) execution tagging. When a data-driven\n  // case fans out, each data row produces its own RunResult tagged with:\n  //   dataRowIndex — 0-based position of the row within its data set\n  //   dataRowLabel — human label, e.g. \"Row 2 · negative · Admin\"\n  //   dataSetName  — the source sheet name\n  // All null for ordinary (non-data-driven) cases → legacy rows + the common\n  // path are unchanged. The frontend groups results by testCaseId and shows\n  // each row under the case via dataRowLabel.\n  dataRowIndex             Int?\n  dataRowLabel             String?\n  dataSetName              String?\n  createdAt                DateTime @default(now())\n\n  run       Run        @relation(fields: [runId], references: [id], onDelete: Cascade)\n  testCase  TestCase   @relation(fields: [testCaseId], references: [id], onDelete: Cascade)\n  downloads Download[]\n\n  @@index([runId])\n  // Phase H M1 — composite index for the disagreement-rate dashboard query\n  // which scans by (version, recency, direction). Without this the\n  // rolling-7-day GROUP BY scans the full table as RunResult grows.\n  @@index([verdictVersion, createdAt, flipDirection])\n  // TestData Round B — fetch every fan-out row of one case in a run.\n  @@index([runId, testCaseId])\n}\n\n// ── Agent runs (Architect / Planner / Conductor) ────────────\nmodel AgentRun {\n  id          String    @id @default(uuid())\n  projectId   String\n  userId      String\n  phase       String // 'architect' | 'planner' | 'conductor'\n  status      String    @default(\"running\") // running | complete | failed | cancelled\n  input       String? // JSON-encoded\n  output      String? // JSON-encoded\n  log         String? // JSON-encoded array of { ts, level, message }\n  error       String?\n  startedAt   DateTime  @default(now())\n  completedAt DateTime?\n\n  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)\n  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)\n\n  @@index([projectId, phase])\n}\n\n// ── Knowledge base locators ─────────────────────────────────\n// Phase E1 (BUILD_PLAN_V2): self-healing intent model. The added columns are\n// nullable so legacy rows (which exist only because they were upserted from\n// the Conductor's first sighting) keep working. The healer agent consumes\n// `intent` / `accessibleName` / `role` / `pageUrl` / `domAnchor` when a\n// locator fails; on a successful heal it appends to `healHistory` and bumps\n// `healthScore`. A locator that drops to `healthScore < 30` is quarantined\n// (Conductor refuses to use it and emits a BlockedItem instead).\nmodel KnowledgeBaseLocator {\n  id              String    @id @default(uuid())\n  projectId       String\n  element         String // human label\n  selector        String // CSS / XPath / role\n  strategy        String? // 'role' | 'testid' | 'css' | 'xpath'\n  occurrences     Int       @default(1)\n  healthScore     Int       @default(100)\n  lastHealedAt    DateTime?\n  // E1 intent model\n  intent          String? // semantic description: \"primary login submit button\"\n  accessibleName  String? // captured from MCP accessibility tree at first sighting\n  role            String? // ARIA role at first sighting\n  // P3-4: pageUrl is part of the unique key. Default '' (NOT NULL) so the\n  // unique constraint dedupes legacy rows. Treating NULL would re-permit\n  // duplicates because both SQLite and Postgres treat NULLs as distinct in\n  // unique constraints.\n  pageUrl         String    @default(\"\") // URL where this locator lives\n  domAnchor       String? // JSON-encoded short snippet of nearby accessibility tree\n  failureCount    Int       @default(0)\n  lastFailedAt    DateTime?\n  // JSON array of {ts, oldSelector, newSelector, reason, confidence}.\n  // Append-only; the healer adds one entry per heal attempt.\n  healHistory     String?\n  // Reserved for cross-project locator lineage when healed selectors are\n  // promoted to a shared library. Stays NULL on a single-project install.\n  parentProjectId String?\n  createdAt       DateTime  @default(now())\n  updatedAt       DateTime  @updatedAt\n\n  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)\n\n  // P3-4: compound key with pageUrl so cross-page collisions don't corrupt\n  // heal history. Legacy rows backfill to pageUrl='' (handled by the\n  // accompanying migration + ghost-merge logic in recordSuccessfulLocator).\n  @@unique([projectId, element, pageUrl])\n  @@index([projectId])\n  @@index([projectId, healthScore])\n}\n\n// ── Generated Playwright PRs awaiting human approval ────────\nmodel GovernancePR {\n  id               String    @id @default(uuid())\n  projectId        String\n  sprintId         String?\n  runId            String?\n  testCaseId       String?\n  number           String // e.g. \"#101\"\n  filename         String\n  requirement      String\n  specCode         String // @db.Text on Postgres\n  lintPassed       Boolean   @default(true)\n  lintFindings     String? // JSON-encoded [{ rule, severity, line, message }, ...]\n  status           String    @default(\"pending\") // pending | approved | merged | rejected\n  reviewer         String?\n  reviewedAt       DateTime?\n  // Phase E7 — external Git provider state. All nullable; set only when an\n  // operator clicks \"Push to Git\" and the API call succeeds.\n  providerPrNumber String? // GitHub PR number (\"1234\")\n  providerPrUrl    String? // Full URL of the external PR\n  providerStatus   String? // 'open' | 'merged' | 'closed' | 'error'\n  providerBranch   String? // Branch the spec was committed onto\n  pushedAt         DateTime?\n  pushedBy         String? // Email of the user who triggered the push\n  createdAt        DateTime  @default(now())\n  updatedAt        DateTime  @updatedAt\n\n  project  Project     @relation(fields: [projectId], references: [id], onDelete: Cascade)\n  // SetNull keeps the PR row as historical audit even after the source TC\n  // is regenerated — dashboards filter `testCaseId != null` to count only\n  // PRs whose case still exists.\n  testCase TestCase?   @relation(fields: [testCaseId], references: [id], onDelete: SetNull)\n  comments PRComment[]\n\n  // Two different projects could otherwise produce PR #101 — make the\n  // human-facing number unique per project so cross-project references\n  // (links, audit logs) are unambiguous.\n  @@unique([projectId, number])\n  @@index([projectId, status])\n  @@index([sprintId])\n}\n\n// ── PR comments (Phase 8 governance UX) ────────────────────\n// Free-form review threads on a GovernancePR. Cascades on PR delete so\n// stale threads don't linger after a TC regen wipes the parent row.\nmodel PRComment {\n  id        String   @id @default(uuid())\n  prId      String\n  // Email of the comment author. We don't FK to User here because PRs are\n  // referenced cross-project and the comment surface is intentionally\n  // lightweight — author is for display only.\n  author    String\n  body      String\n  createdAt DateTime @default(now())\n\n  pr GovernancePR @relation(fields: [prId], references: [id], onDelete: Cascade)\n\n  @@index([prId, createdAt])\n}\n\n// ── Blocked items (failed locators surfaced for human triage) ─\nmodel BlockedItem {\n  id              String    @id @default(uuid())\n  projectId       String\n  sprintId        String?\n  runId           String?\n  testCaseId      String?\n  reason          String // 'locator_missing' | 'timeout' | 'assertion' | 'network' | 'agent_loop' | ...\n  locator         String?\n  message         String\n  // Severity for triage sort. Defaults to 'normal' for legacy rows. The\n  // blockageAnalyzer agent may upgrade this to 'high' for blockers it judges\n  // release-critical, or downgrade to 'low' for noise.\n  severity        String    @default(\"normal\") // 'low' | 'normal' | 'high'\n  // Optional engineer assignment + free-text resolve note for triage.\n  assignee        String? // free-form name/email — not joined to User to keep this lightweight\n  resolveNote     String? // human note captured at resolve/skip time\n  resolved        Boolean   @default(false)\n  resolvedAt      DateTime?\n  // ── Phase 7 / M2: AI blockage reasoning ──────────────────\n  // Populated by `services/agents/blockageAnalyzer.js`. All nullable so\n  // legacy rows stay valid; analysis is opt-in (auto on run.complete when\n  // blockedCount > 0, plus the Re-analyse button).\n  aiSummary       String? // 1-2 sentence narrative explaining the blocker\n  aiCategory      String? // 'dependency_failure' | 'environment' | 'data_unavailable' | 'selector_drift' | 'flake' | 'unknown'\n  aiRootCauseTcId String? // upstream TestCase id when this blocker is downstream of another failure\n  aiSuggestedFix  String? // one-line actionable next step\n  aiAnalyzedAt    DateTime? // when the analyzer last touched this row\n  createdAt       DateTime  @default(now())\n\n  project  Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)\n  // SetNull preserves the row for historical reporting after a regen, but\n  // dashboards filter testCaseId != null so stale blockers aren't surfaced\n  // as \"still actionable\".\n  testCase TestCase? @relation(fields: [testCaseId], references: [id], onDelete: SetNull)\n\n  @@index([projectId, resolved])\n  @@index([sprintId])\n}\n\n// ── Audit log ───────────────────────────────────────────────\nmodel AuditLog {\n  id        String   @id @default(uuid())\n  userId    String?\n  // Phase E8 — tenant tag. Nullable for legacy rows; new entries written\n  // by audit.log() always set it from the request's resolved org.\n  orgId     String?\n  action    String // 'auth.login' | 'settings.claude.save' | 'secret.delete' | etc.\n  target    String? // entity affected\n  metadata  String? // JSON-encoded\n  ipAddress String?\n  userAgent String?\n  createdAt DateTime @default(now())\n\n  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)\n\n  @@index([userId, createdAt])\n  @@index([action, createdAt])\n  @@index([orgId, createdAt])\n}\n\n// ── Phase E10.3 — Per-user daily token budget ────────────────\n//\n// One row per (user, UTC date, provider). The budget service\n// upserts on every successful provider.complete() call to tally\n// input + output tokens. The header chip reads \"today's total\n// across providers\" via GET /api/budget/status.\n//\n// `date` is stored as a YYYY-MM-DD string (UTC) so the unique\n// index keys don't depend on TZ math at write time — every server\n// is in agreement about \"what day this is\".\nmodel UserDailyUsage {\n  id           String   @id @default(uuid())\n  userId       String\n  date         String // YYYY-MM-DD (UTC)\n  provider     String // 'claude' | 'gemini'\n  inputTokens  Int      @default(0)\n  outputTokens Int      @default(0)\n  callCount    Int      @default(0)\n  blockedCount Int      @default(0) // calls that were refused for exceeding limit\n  updatedAt    DateTime @updatedAt\n\n  user User @relation(fields: [userId], references: [id], onDelete: Cascade)\n\n  @@unique([userId, date, provider])\n  @@index([userId, date])\n}\n\n// ── Phase G — Cross-run failure patterns ────────────────────\n//\n// The closed-loop learning store. After every failed/blocked RunResult that\n// the Reporter has produced an RCA for, the postMortem agent classifies the\n// failure into a project-scoped *pattern* — a recurring trap (e.g. \"post-click\n// snapshot races the redirect\") with a reusable resolution lesson.\n//\n// On the NEXT conductor invocation for this project, the top-N patterns by\n// occurrence are injected into the system prompt under \"## Learned from prior\n// runs on this project\" so the agent has the lesson as a prior, not a hint we\n// hardcoded. The same patterns feed `rcaChat` so per-failure user chat answers\n// reference the project's own history rather than generic advice.\n//\n// `signature` is a stable hash of the pattern's defining traits — keyed\n// (projectId, signature) so upserts are deterministic. The category enum is\n// soft: postMortem proposes a category but the column accepts any string so we\n// can grow the vocabulary without a migration. `exampleRunResultIds` is a\n// JSON-encoded array (up to 3 most-recent) so the chat can deep-link to a\n// real instance when a user asks \"show me where this happened before\".\nmodel FailurePattern {\n  id                  String   @id @default(uuid())\n  projectId           String\n  signature           String\n  category            String\n  title               String\n  description         String\n  trigger             String\n  resolution          String\n  occurrences         Int      @default(1)\n  exampleRunResultIds String?\n  firstSeenAt         DateTime @default(now())\n  lastSeenAt          DateTime @default(now())\n\n  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)\n\n  @@unique([projectId, signature])\n  @@index([projectId, occurrences])\n  @@index([projectId, lastSeenAt])\n}\n\n// ── AuthFixture (E2) ────────────────────────────────────────────────────────\n// Pre-captured Playwright storageState (cookies + localStorage) for a given\n// role/environment. Injected at browser context creation so the Conductor\n// starts already authenticated — the identity provider is never navigated.\n// Operators capture fixtures by running a one-time manual auth recording\n// script, then paste the JSON here.\nmodel AuthFixture {\n  id           String    @id @default(cuid())\n  projectId    String\n  project      Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)\n  name         String // e.g. \"admin_sso\", \"readonly_user\"\n  storageState String // JSON from context.storageState() — cookies + localStorage\n  environment  String    @default(\"default\")\n  notes        String?\n  validUntil   DateTime?\n  createdAt    DateTime  @default(now())\n  updatedAt    DateTime  @updatedAt\n\n  @@index([projectId])\n}\n\n// ── AuthProfile (Enterprise Mode P4b — declared business IDENTITY) ───────────\n// A case binds to an identity (admin/demo/maker/checker/readonly/region:…), NOT to\n// a captured session blob. The profile declares HOW QAAI authenticates as it\n// (strategy) and what QAAI does when it cannot (disposition). It MAY reference an\n// AuthFixture (storageState) when disposition=bypass_fixture, or a named credential\n// (Project.testCredentials key) when supported_test_hook — never an inline secret.\n// AuthProfile.id is the authProfileId used in the atlas slice key (P3b pickSlice\n// wrong-role firewall), so a case authored \"as admin\" grounds ONLY on admin\n// evidence. See ENTERPRISE_MODE.md → \"P4 → P4b\".\nmodel AuthProfile {\n  id            String   @id @default(uuid())\n  projectId     String\n  name          String // admin | demo | maker | checker | readonly | region:eu …\n  strategy      String   @default(\"form\") // form | sso | token | mfa | basic | none\n  disposition   String   @default(\"bypass_fixture\") // bypass_fixture | supported_test_hook | manual_gate | unsupported\n  authFixtureId String? // → AuthFixture (when bypass_fixture)\n  credentialRef String? // named Project.testCredentials key (when supported_test_hook); NEVER an inline secret\n  environment   String   @default(\"default\")\n  notes         String?\n  createdAt     DateTime @default(now())\n  updatedAt     DateTime @updatedAt\n\n  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)\n\n  @@unique([projectId, name])\n  @@index([projectId])\n}\n",
  "inlineSchemaHash": "482cd48be4e2d063482e9128472178b31961fd5b4ad86ec33ece3285ef29a676",
  "copyEngine": true
}

const fs = require('fs')

config.dirname = __dirname
if (!fs.existsSync(path.join(__dirname, 'schema.prisma'))) {
  const alternativePaths = [
    "server/node_modules/.prisma/client",
    "node_modules/.prisma/client",
  ]
  
  const alternativePath = alternativePaths.find((altPath) => {
    return fs.existsSync(path.join(process.cwd(), altPath, 'schema.prisma'))
  }) ?? alternativePaths[0]

  config.dirname = path.join(process.cwd(), alternativePath)
  config.isBundled = true
}

