  userId      String
  phase       String // 'architect' | 'planner' | 'conductor'
  status      String    @default("running") // running | complete | failed | cancelled
  input       String? // JSON-encoded
  output      String? // JSON-encoded
  log         String? // JSON-encoded array of { ts, level, message }
  error       String?
  startedAt   DateTime  @default(now())
  completedAt DateTime?

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([projectId, phase])
}

// ── Knowledge base locators ─────────────────────────────────
// Phase E1 (BUILD_PLAN_V2): self-healing intent model. The added columns are
// nullable so legacy rows (which exist only because they were upserted from
// the Conductor's first sighting) keep working. The healer agent consumes
// `intent` / `accessibleName` / `role` / `pageUrl` / `domAnchor` when a
// locator fails; on a successful heal it appends to `healHistory` and bumps
// `healthScore`. A locator that drops to `healthScore < 30` is quarantined
// (Conductor refuses to use it and emits a BlockedItem instead).
model KnowledgeBaseLocator {
  id              String    @id @default(uuid())
  projectId       String
  element         String // human label
  selector        String // CSS / XPath / role
  strategy        String? // 'role' | 'testid' | 'css' | 'xpath'
  occurrences     Int       @default(1)
  healthScore     Int       @default(100)
  lastHealedAt    DateTime?
  // E1 intent model
  intent          String? // semantic description: "primary login submit button"
  accessibleName  String? // captured from MCP accessibility tree at first sighting
  role            String? // ARIA role at first sighting
  // P3-4: pageUrl is part of the unique key. Default '' (NOT NULL) so the
  // unique constraint dedupes legacy rows. Treating NULL would re-permit
  // duplicates because both SQLite and Postgres treat NULLs as distinct in
  // unique constraints.
  pageUrl         String    @default("") // URL where this locator lives
  domAnchor       String? // JSON-encoded short snippet of nearby accessibility tree
  interactionRecipeJson String? // JSON recipe for deterministic widget execution/readback
  failureCount    Int       @default(0)
  lastFailedAt    DateTime?
  // JSON array of {ts, oldSelector, newSelector, reason, confidence}.
  // Append-only; the healer adds one entry per heal attempt.
  healHistory     String?
  // Reserved for cross-project locator lineage when healed selectors are
  // promoted to a shared library. Stays NULL on a single-project install.
  parentProjectId String?
  // Phase C — KB lifecycle. lastUsedAt is set on every successful manifest
  // lookup; the 30-day reaper cron marks stale rows as deprecated (excluded
  // from manifest lookups but preserved for audit).
  // updatedByRunId provides lineage: which run last wrote this locator via
  // evidence repair or recordSuccessfulLocator.
  lastUsedAt      DateTime?
  deprecated      Boolean   @default(false)
  updatedByRunId  String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  // P3-4: compound key with pageUrl so cross-page collisions don't corrupt
  // heal history. Legacy rows backfill to pageUrl='' (handled by the
  // accompanying migration + ghost-merge logic in recordSuccessfulLocator).
  @@unique([projectId, element, pageUrl])
  @@index([projectId])
  @@index([projectId, healthScore])
}

// ── Active project execution memory ────────────────────────────────
// Memory-first reruns. Each successful element action is stored by stable
// semantic intent, not raw step number, so inserted/reordered steps can still
// reuse the same proven locator.
model ProjectActionMemory {
  id                       String   @id @default(uuid())
  projectId                String
  testCaseId               String   @default("")
  scenarioId               String?
  module                   String?
  stepOrdinal              Int?
  stepIntentHash           String
  stepIntentHashVersion    String   @default("qaai-step-intent-v1")
  stepIntentPartsJson      String?
  routeKey                 String
  pageUrl                  String   @default("")
  toolName                 String
  actionType               String
  elementKey               String
  elementLabel             String?
  selectorExpression       String?
  frameworkExpressionsJson String?
  actionLocatorJson        String?
  targetFactsJson          String?
  contextJson              String?
  domAtlasPageJson         String?
  successCount             Int      @default(1)
  failureCount             Int      @default(0)
  healthScore              Int      @default(100)
  trustState               String   @default("candidate") // candidate | trusted | degraded | quarantined
  lastRunId                String?
  lastRunResultId          String?
  lastUsedAt               DateTime?
  createdAt                DateTime @default(now())
  updatedAt                DateTime @updatedAt

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([projectId, testCaseId, routeKey, actionType, stepIntentHash])
  @@index([projectId, testCaseId])
  @@index([projectId, routeKey, actionType])
  @@index([projectId, healthScore])
  @@index([projectId, trustState])
}

// ── Export Certification (Phase C) ─────────────────────────
// One record per framework per journey per certification attempt.
// The source of truth for the Output Files page certification badge.
// Created/updated by emitJourneySpecs + executionHarness — never by
// direct API write.
model ExportCertification {
  id                 String    @id @default(uuid())
  projectId          String
  runId              String
  framework          String    // 'playwright-ts' | 'playwright-js' | 'selenium-testng' | ...
  journeySlug        String    // cleanSlug of the journey (module + first-case name)
  sourceRunResultIds String    // JSON array of RunResult.id strings in this journey
  irHash             String?   // SHA256 of concatenated replayIrJson — stale if IR changes
  actionJournalHash  String?   // SHA256 of the Evidence Bundle (serialised actions post-disposition)
  packageHash        String?   // SHA256 of the generated spec files
  status             String    @default("pending")
  // pending | draft | repairing | incomplete_evidence | not_exportable | certified
  parityMatched      Boolean?
  mcpVerdict         String?   // 'pass' | 'fail' | 'blocked' | 'skipped'
  runnerVerdict      String?   // execution harness verdict
  kbMissCount        Int       @default(0)
  repairRound        Int       @default(0)
  gaps               String?   // JSON: [{type, description, pageUrl?, repairable}]
  artifacts          String?   // JSON: [{type:'screenshot'|'trace', path: 'relative/path'}]
  pipelineTraceId    String?   // lineage: runId + '-' + journeySlug + '-' + attempt
  certifiedAt        DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  run     Run     @relation(fields: [runId], references: [id], onDelete: Cascade)

  @@index([projectId])
  @@index([runId])
  @@index([status, createdAt])
}

// ── Generated Playwright PRs awaiting human approval ────────
model GovernancePR {
  id               String    @id @default(uuid())
  projectId        String
  sprintId         String?
  runId            String?
  testCaseId       String?
  number           String // e.g. "#101"
  filename         String
  requirement      String
  specCode         String // @db.Text on Postgres
  lintPassed       Boolean   @default(true)
  lintFindings     String? // JSON-encoded [{ rule, severity, line, message }, ...]
  status           String    @default("pending") // pending | approved | merged | rejected
  reviewer         String?
  reviewedAt       DateTime?
  // Phase E7 — external Git provider state. All nullable; set only when an
  // operator clicks "Push to Git" and the API call succeeds.
  providerPrNumber String? // GitHub PR number ("1234")
  providerPrUrl    String? // Full URL of the external PR
  providerStatus   String? // 'open' | 'merged' | 'closed' | 'error'
  providerBranch   String? // Branch the spec was committed onto
  pushedAt         DateTime?
  pushedBy         String? // Email of the user who triggered the push
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  project  Project     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  // SetNull keeps the PR row as historical audit even after the source TC
  // is regenerated — dashboards filter `testCaseId != null` to count only
  // PRs whose case still exists.
  testCase TestCase?   @relation(fields: [testCaseId], references: [id], onDelete: SetNull)
  comments PRComment[]

  // Two different projects could otherwise produce PR #101 — make the
  // human-facing number unique per project so cross-project references
  // (links, audit logs) are unambiguous.
  @@unique([projectId, number])
  @@index([projectId, status])
  @@index([sprintId])
}

// ── PR comments (Phase 8 governance UX) ────────────────────
// Free-form review threads on a GovernancePR. Cascades on PR delete so
// stale threads don't linger after a TC regen wipes the parent row.
model PRComment {
  id        String   @id @default(uuid())
  prId      String
  // Email of the comment author. We don't FK to User here because PRs are
  // referenced cross-project and the comment surface is intentionally
  // lightweight — author is for display only.
  author    String
  body      String
  createdAt DateTime @default(now())

  pr GovernancePR @relation(fields: [prId], references: [id], onDelete: Cascade)

  @@index([prId, createdAt])
}

// ── Blocked items (failed locators surfaced for human triage) ─
model BlockedItem {
  id              String    @id @default(uuid())
  projectId       String
  sprintId        String?
  runId           String?
  testCaseId      String?
  reason          String // 'locator_missing' | 'timeout' | 'assertion' | 'network' | 'agent_loop' | ...
  locator         String?
  message         String
  // Severity for triage sort. Defaults to 'normal' for legacy rows. The
  // blockageAnalyzer agent may upgrade this to 'high' for blockers it judges
  // release-critical, or downgrade to 'low' for noise.
  severity        String    @default("normal") // 'low' | 'normal' | 'high'
  // Optional engineer assignment + free-text resolve note for triage.
  assignee        String? // free-form name/email — not joined to User to keep this lightweight
  resolveNote     String? // human note captured at resolve/skip time
  resolved        Boolean   @default(false)
  resolvedAt      DateTime?
  // ── Phase 7 / M2: AI blockage reasoning ──────────────────
  // Populated by `services/agents/blockageAnalyzer.js`. All nullable so
  // legacy rows stay valid; analysis is opt-in (auto on run.complete when
  // blockedCount > 0, plus the Re-analyse button).
  aiSummary       String? // 1-2 sentence narrative explaining the blocker
  aiCategory      String? // 'dependency_failure' | 'environment' | 'data_unavailable' | 'selector_drift' | 'flake' | 'unknown'
  aiRootCauseTcId String? // upstream TestCase id when this blocker is downstream of another failure
  aiSuggestedFix  String? // one-line actionable next step
  aiAnalyzedAt    DateTime? // when the analyzer last touched this row
  createdAt       DateTime  @default(now())

  project  Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  // SetNull preserves the row for historical reporting after a regen, but
  // dashboards filter testCaseId != null so stale blockers aren't surfaced
  // as "still actionable".
  testCase TestCase? @relation(fields: [testCaseId], references: [id], onDelete: SetNull)

  @@index([projectId, resolved])
  @@index([sprintId])
}

// ── Audit log ───────────────────────────────────────────────
model AuditLog {
  id        String   @id @default(uuid())
  userId    String?
  // Phase E8 — tenant tag. Nullable for legacy rows; new entries written
  // by audit.log() always set it from the request's resolved org.
  orgId     String?
  action    String // 'auth.login' | 'settings.claude.save' | 'secret.delete' | etc.
  target    String? // entity affected
  metadata  String? // JSON-encoded
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
  @@index([action, createdAt])
  @@index([orgId, createdAt])
}

// ── Phase E10.3 — Per-user daily token budget ────────────────
//
// One row per (user, UTC date, provider). The budget service
// upserts on every successful provider.complete() call to tally
// input + output tokens. The header chip reads "today's total
// across providers" via GET /api/budget/status.
//
// `date` is stored as a YYYY-MM-DD string (UTC) so the unique
// index keys don't depend on TZ math at write time — every server
// is in agreement about "what day this is".
model UserDailyUsage {
  id           String   @id @default(uuid())
  userId       String
  date         String // YYYY-MM-DD (UTC)
  provider     String // 'claude' | 'gemini'
  inputTokens  Int      @default(0)
  outputTokens Int      @default(0)
  callCount    Int      @default(0)
  blockedCount Int      @default(0) // calls that were refused for exceeding limit
  updatedAt    DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, date, provider])
  @@index([userId, date])
}

// ── Phase G — Cross-run failure patterns ────────────────────
//
// The closed-loop learning store. After every failed/blocked RunResult that
// the Reporter has produced an RCA for, the postMortem agent classifies the
// failure into a project-scoped *pattern* — a recurring trap (e.g. "post-click
// snapshot races the redirect") with a reusable resolution lesson.
//
// On the NEXT conductor invocation for this project, the top-N patterns by
// occurrence are injected into the system prompt under "## Learned from prior
// runs on this project" so the agent has the lesson as a prior, not a hint we
// hardcoded. The same patterns feed `rcaChat` so per-failure user chat answers
// reference the project's own history rather than generic advice.
//
// `signature` is a stable hash of the pattern's defining traits — keyed
// (projectId, signature) so upserts are deterministic. The category enum is
// soft: postMortem proposes a category but the column accepts any string so we
// can grow the vocabulary without a migration. `exampleRunResultIds` is a
// JSON-encoded array (up to 3 most-recent) so the chat can deep-link to a
// real instance when a user asks "show me where this happened before".
model FailurePattern {
  id                  String   @id @default(uuid())
  projectId           String
  signature           String
  category            String
  title               String
  description         String
  trigger             String
  resolution          String
  occurrences         Int      @default(1)
  exampleRunResultIds String?
  firstSeenAt         DateTime @default(now())
  lastSeenAt          DateTime @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([projectId, signature])
  @@index([projectId, occurrences])
  @@index([projectId, lastSeenAt])
}

// ── AuthFixture (E2) ────────────────────────────────────────────────────────
// Pre-captured Playwright storageState (cookies + localStorage) for a given
// role/environment. Injected at browser context creation so the Conductor
// starts already authenticated — the identity provider is never navigated.
// Operators capture fixtures by running a one-time manual auth recording
// script, then paste the JSON here.
model AuthFixture {
  id           String    @id @default(cuid())
  projectId    String
  project      Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  name         String    // e.g. "admin_sso", "readonly_user"
  storageState String    // JSON from context.storageState() — cookies + localStorage
  environment  String    @default("default")
  notes        String?
  validUntil   DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([projectId])
}

// ── AuthProfile (Enterprise Mode P4b — declared business IDENTITY) ───────────
// A case binds to an identity (admin/demo/maker/checker/readonly/region:…), NOT to
// a captured session blob. The profile declares HOW QAAI authenticates as it
// (strategy) and what QAAI does when it cannot (disposition). It MAY reference an
// AuthFixture (storageState) when disposition=bypass_fixture, or a named credential
// (Project.testCredentials key) when supported_test_hook — never an inline secret.
// AuthProfile.id is the authProfileId used in the atlas slice key (P3b pickSlice
// wrong-role firewall), so a case authored "as admin" grounds ONLY on admin
// evidence. See ENTERPRISE_MODE.md → "P4 → P4b".
model AuthProfile {
  id            String   @id @default(uuid())
  projectId     String
  name          String // admin | demo | maker | checker | readonly | region:eu …
  strategy      String   @default("form") // form | sso | token | mfa | basic | none
  disposition   String   @default("bypass_fixture") // bypass_fixture | supported_test_hook | manual_gate | unsupported
  authFixtureId String? // → AuthFixture (when bypass_fixture)
  credentialRef String? // named Project.testCredentials key (when supported_test_hook); NEVER an inline secret
  environment   String   @default("default")
  notes         String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([projectId, name])
  @@index([projectId])
}
