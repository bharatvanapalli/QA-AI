// QAAI Prisma schema — SQLite (development).
//
// To switch to PostgreSQL for production:
//   1. Change provider below to "postgresql"
//   2. Set DATABASE_URL to a postgres connection string
//   3. Re-enable `String[]` types (currently stored as JSON-encoded String for
//      SQLite compatibility — see WebhookConfig.events and RunResult.screenshots)
//   4. Delete prisma/migrations and re-run `npx prisma migrate dev --name init`
//
// Generate client : npx prisma generate
// Run migration   : npx prisma migrate dev

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ── Users & sessions ─────────────────────────────────────────
model User {
  id              String    @id @default(uuid())
  email           String    @unique
  passwordHash    String
  firstName       String?
  lastName        String?
  role            String    @default("user") // user | admin | lead (platform role)
  organisation    String?
  // Phase E8 — multi-tenancy. currentOrgId pins the org the user is
  // actively working in. New rows (projects, secrets, etc.) get this
  // orgId stamped on them. Switching orgs (when E8 invites land) flips
  // this field via PUT /api/org/switch.
  currentOrgId    String?
  // Phase E10.3 — per-user daily token ceiling. null = use system
  // default (BUDGET_DEFAULT_DAILY_TOKENS env). Override per user in
  // Settings → AI Provider when a heavy user wants more headroom.
  dailyTokenLimit Int?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  lastLoginAt     DateTime?

  sessions          Session[]
  projects          Project[]
  secrets           Secret[]
  integrations      Integration[]
  webhookConfigs    WebhookConfig[]
  notificationChans NotificationChannel[]
  auditLogs         AuditLog[]
  runs              Run[]
  agentRuns         AgentRun[]
  dailyUsage        UserDailyUsage[]
  // E8 — org memberships + ownership + sent invites
  ownedOrgs         Organization[]        @relation("OrgOwner")
  orgMemberships    OrgMembership[]
  sentInvites       OrgInvite[]           @relation("OrgInviteSender")
}

// ── Phase E8 — Multi-tenancy substrate ──────────────────────
//
// An Organization is the tenancy boundary. Every Project, Secret,
// Integration, WebhookConfig, NotificationChannel, and AuditLog row is
// scoped to one Org. Users belong to one or more Orgs via OrgMembership;
// `User.currentOrgId` pins the active org for the session.
//
// Owner is the user who created the org. Owner has full control
// (rename, invite, remove members, transfer ownership in a future
// phase). Members and admins are added via OrgInvite → OrgMembership.
model Organization {
  id        String   @id @default(uuid())
  name      String
  slug      String   @unique // url-safe identifier; auto-derived from name
  ownerId   String
  plan      String   @default("solo") // 'solo' | 'team' | 'enterprise'
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  owner       User            @relation("OrgOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  memberships OrgMembership[]
  invites     OrgInvite[]

  @@index([ownerId])
}

model OrgMembership {
  id        String   @id @default(uuid())
  orgId     String
  userId    String
  role      String   @default("member") // 'owner' | 'admin' | 'member'
  createdAt DateTime @default(now())

  organization Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([orgId, userId])
  @@index([userId])
}

model OrgInvite {
  id         String    @id @default(uuid())
  orgId      String
  email      String // who we're inviting (case-insensitive match at accept time)
  role       String    @default("member")
  token      String    @unique // random hex; emailed to invitee
  invitedBy  String // userId who sent the invite
  expiresAt  DateTime
  acceptedAt DateTime?
  createdAt  DateTime  @default(now())

  organization Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  sender       User         @relation("OrgInviteSender", fields: [invitedBy], references: [id], onDelete: Cascade)

  @@index([orgId])
  @@index([email])
}

model Session {
  id          String    @id @default(uuid())
  userId      String
  refreshHash String    @unique
  userAgent   String?
  ipAddress   String?
  expiresAt   DateTime
  revokedAt   DateTime?
  createdAt   DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// ── Secrets (encrypted blobs, keyed by user + name) ──────────
model Secret {
  id         String   @id @default(uuid())
  userId     String
  // Phase E8 — org tenancy. Nullable in the schema to keep legacy rows
  // valid; new rows are required to set this via the requireOrg middleware.
  orgId      String?
  name       String // e.g. "claude.apiKey", "ado.pat", "jira.token", "webhook.secret"
  ciphertext String // hex-encoded AES-256-GCM
  iv         String // hex-encoded IV
  authTag    String // hex-encoded auth tag
  lastFour   String? // last 4 chars of plaintext for UI display
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, name])
  @@index([orgId])
}

// ── Integration configs (Claude, ADO, Jira) ──────────────────
model Integration {
  id              String    @id @default(uuid())
  userId          String
  // Phase E8 — see Secret.orgId note. Backfilled to the user's Solo org.
  orgId           String?
  type            String // 'claude' | 'ado' | 'jira'
  config          String    @default("{}") // JSON-encoded — see jsonField helpers
  status          String    @default("unconfigured") // unconfigured | valid | invalid
  lastValidatedAt DateTime?
  lastError       String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, type])
  @@index([orgId])
}

// ── Webhook delivery target ─────────────────────────────────
model WebhookConfig {
  id             String   @id @default(uuid())
  userId         String
  // Phase E8 — see Secret.orgId note.
  orgId          String?
  url            String
  events         String // JSON-encoded string[] — see helpers in services. Postgres can use String[] directly.
  enabled        Boolean  @default(true)
  lastFourSecret String? // last 4 chars of signing secret for display
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  user       User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  deliveries WebhookDelivery[]

  @@index([userId])
  @@index([orgId])
}

model WebhookDelivery {
  id           String   @id @default(uuid())
  webhookId    String
  event        String
  payload      String   @default("{}") // JSON-encoded
  statusCode   Int?
  responseBody String?
  latencyMs    Int?
  attempts     Int      @default(1)
  succeeded    Boolean  @default(false)
  error        String?
  createdAt    DateTime @default(now())

  webhook WebhookConfig @relation(fields: [webhookId], references: [id], onDelete: Cascade)

  @@index([webhookId, createdAt])
}

// ── Notification channels & routing ─────────────────────────
model NotificationChannel {
  id              String    @id @default(uuid())
  userId          String
  // Phase E8 — see Secret.orgId note.
  orgId           String?
  type            String // 'email' | 'slack' | 'webhook'
  target          String // email address, slack webhook URL, generic URL
  verified        Boolean   @default(false)
  lastTestAt      DateTime?
  lastTestSuccess Boolean?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  user   User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  routes NotificationRoute[]

  @@index([userId])
  @@index([orgId])
}

model NotificationRoute {
  id        String @id @default(uuid())
  channelId String
  event     String // 'run.completed', 'run.failed', 'locator.blocked', 'governance.pr_ready', ...

  channel NotificationChannel @relation(fields: [channelId], references: [id], onDelete: Cascade)

  @@unique([channelId, event])
}

// ── Project / Run / TestCase domain ─────────────────────────
model Project {
  id                       String   @id @default(uuid())
  userId                   String
  // Phase E8 — multi-tenancy. The org this project belongs to.
  // Nullable in the schema for backfill compatibility; the requireOrg
  // middleware refuses creates/reads that don't carry an orgId.
  orgId                    String?
  name                     String
  environment              String   @default("staging")
  framework                String   @default("playwright-pom")
  targetUrl                String?
  // Free-form notes the user wants every AI agent to honour on this project.
  // Prepended to every agent's system prompt via server/lib/promptCompose.
  // Example: "This app uses MUI date pickers — prefer aria-label='Choose date'".
  aiGuidance               String?
  // Verifier-layer synonyms. JSON-encoded array of:
  //   [{ canonical: "A-Z", variants: ["A to Z", "AtoZ"] },
  //    { canonical: "confirmation page", variants: ["Thank you for your order!"] }]
  // The deterministic `assertion_check` normaliser substitutes every variant
  // occurrence with its canonical form before substring matching — so a
  // declared assertion of "A-Z" matches a page rendering "Name (A to Z)".
  // Populated by the "Save as project synonym" flow after a semantic-fallback
  // rerun rescues a case. Editable by the operator in Settings → Claude.
  assertionEquivalences    String?
  // PAGE assertion sprint — per-project learned-page-identity store.
  // Populated by the Conductor when a PAGE assertion matches (either via the
  // deterministic 2-of-{role=2, text=1, url=1} quorum or via LLM semantic
  // rescue when cold-start architect signals miss). Read by the page matcher
  // to augment the architect's declared signals with previously-verified
  // ones. Each atlas signal carries { source, verifiedCount, firstSeenAt } so
  // unverified entries contribute at half weight and only promote to full
  // weight after two independent runs corroborate them (strict corroboration
  // trigger). Nullable — projects without an atlas run on architect signals
  // alone. See server/services/agents/conductor.js for the recording hook
  // and server/services/mcp.js#matchPageAssertion for the matcher.
  pageAtlas                String?
  // Which LLM provider runs the 7 agents for this project. Default 'claude'
  // keeps existing projects working unchanged. 'gemini' routes via the
  // Google Generative AI SDK with the same canonical message shape; see
  // server/lib/providers/gemini.js for the Anthropic <-> Gemini translation.
  aiProvider               String   @default("copilot") // 'claude' | 'gemini' | 'copilot'
  // Phase F (cost control) — execution mode for the Conductor pipeline.
  //   'fast'     (default) — 12 turns/case, 1 conductor attempt, no Supervisor
  //                          finalise pass, inline Critic on errors only.
  //                          Suitable for daily iteration loops.
  //   'thorough' — 22 turns/case, 2 conductor attempts + 1 Supervisor finalise
  //                pass, periodic inline Critic every 5 turns.
  //                Suitable for pre-release gate runs.
  // The single biggest cost lever in the system — see Phase F PHASE_LOG for
  // the 3.5M-token forensics that motivated this column.
  execMode                 String   @default("fast")
  // Enterprise Mode P9 — all-or-nothing trust gate. When true, exports must use
  // the ReplayIR lane and pass package validation + execution-parity evidence
  // before a ZIP can be shipped.
  enterpriseMode           Boolean  @default(false)
  // Test users the QA team has authorised the agent to use for this project.
  // JSON-encoded array of { name, email, password, notes? }. Injected into
  // the Conductor's system prompt as "## Available test users". If a case
  // requires a logged-in user and this list is empty, the agent must end the
  // turn with "BLOCKED: no credentials provided" — fabricating credentials
  // is a known failure mode (Phase D).
  testCredentials          String?
  // E2 — default auth fixture for SSO injection. Points to an AuthFixture.id.
  // When set, the Conductor injects the fixture's storageState at session start
  // so the browser context starts already authenticated.
  defaultAuthFixtureId     String?
  // Phase E3 — code-diff awareness. The repo + branch + provider let the
  // codeDiffAnalyzer agent fetch the actual code change ahead of test
  // generation, so the Architect can bias scenarios toward the surfaces
  // a PR touches. PAT lives in the Secret vault keyed `<provider>.pat`.
  // All three are nullable — diff-context is opt-in.
  repoUrl                  String?
  defaultBranch            String? // 'main' typically
  gitProvider              String? // 'github' | 'gitlab' | 'azure'
  // Phase E10.5 — Browser context configuration. Threaded into
  // @playwright/mcp at session boot so the agent's browser matches the
  // SUT's real-world conditions (auth, locale, geo, device, proxy).
  // All nullable; absent fields fall back to MCP defaults.
  // Sensitive bits (httpCredentials.password, extraHTTPHeaders) live here
  // for v1 simplicity; future hardening moves them to the Secret vault.
  contextViewport          String? // JSON {width, height} — overrides MCP default 1280x720
  contextDevice            String? // e.g. 'iPhone 15' — Playwright device-emulation preset
  contextLocale            String? // BCP-47 e.g. 'en-US', 'fr-FR' — injected via init-script
  contextUserAgent         String? // override default UA string
  contextColorScheme       String? // 'light' | 'dark' | 'no-preference' — via init-script matchMedia override
  contextPermissions       String? // JSON string[] e.g. ['geolocation','clipboard-read','clipboard-write']
  contextGeolocation       String? // JSON {latitude, longitude, accuracy?} — geo permission must be granted too
  contextHttpCredentials   String? // JSON {username, password} for Basic/Digest auth via init-script Authorization header
  contextExtraHeaders      String? // JSON {header: value} — injected via init-script fetch interceptor
  contextIgnoreHttpsErrors Boolean  @default(false)
  contextProxyServer       String? // 'http://host:port' or 'socks5://host:port'
  contextProxyBypass       String? // comma-separated domains
  // Phase E10.5 — Pre-registered dialog handler default. When true
  // (default), the session boot script auto-accepts any window.alert /
  // confirm / prompt that fires unexpectedly so the agent doesn't hang.
  // Set to false on projects where a test explicitly validates dialog
  // copy and needs to handle them manually.
  autoAcceptDialogs        Boolean  @default(true)
  // Headless/headed toggle for the live Conductor's browser launch. Null =
  // use the QAAI_MCP_HEADLESS/PLAYWRIGHT_MCP_HEADLESS env default (headed).
  // Explicit true/false overrides that per project — surfaced as a toggle
  // on the Test Cases page next to the Select control.
  contextHeadless          Boolean?
  // Phase H M1 — per-project override for the mechanical verdict layer.
  // Null = use the QAAI_VERDICT_MODE env default. Captured per-run at
  // Run.verdictMode and immutable for the duration of that run; switching
  // verdict logic mid-suite produces incoherent reports.
  verdictMode              String? // null | 'legacy' | 'mechanical_v1'
  // Phase H+1 — Project-level "known popups" config. JSON array of records
  // declaring popups that may appear on this project's site and should be
  // dismissed defensively. Threaded into BOTH the Conductor's runtime
  // prompt (so the live agent proactively dismisses them) AND the codegen
  // prompt (so generated spec files include a beforeEach hook that
  // dismisses them, surviving re-runs).
  //
  // Schema per record:
  //   {
  //     "name":       "Cookie consent banner",          // human-readable label
  //     "matcher":    { "strategy": "role"|"text"|"testId"|"css"|"label",
  //                     "value":    "<selector|text|regex>",
  //                     "role":     "<optional ARIA role>" },
  //     "scope":      "global" | "first-page-load" | "after-auth",
  //     "afterDismiss": "wait-hidden" | "reload" | null
  //   }
  //
  // Flexible by design — no hardcoded site assumptions. Operators
  // declare popups for their project once; every spec inherits the
  // dismissal logic. Null/empty = no project-level popups; specs still
  // get the defensive-wrapping codegen behaviour for ad-hoc popups.
  knownPopups              String?
  // "Open in VS Code" — absolute folder path on the operator's machine where
  // the generated suite for this project is copied and opened. Local
  // single-tenant convenience: the server writes the run's files here and
  // launches `code <path>`. Nullable; the UI prompts for it on first use.
  vscodeWorkspacePath      String?
  // Phase C — Certification Pipeline. Controls the kbMiss tolerance gate for
  // certified export. NULL treated as 'standard'.
  // 'strict'      = zero kbMiss required for any certified output
  // 'standard'    = kbMiss must be 0 for certified; non-zero allowed for Draft only
  // 'exploratory' = wide draft tolerance; only obvious breaks block export
  exportStrictness         String?
  // Project-local trigger policy used by the Test Cases Configure Trigger
  // modal. JSON string, schema qaai.trigger-config/1. Only stores options the
  // current platform can honor directly; execution profile and auth fixture
  // remain first-class Project fields.
  triggerConfigJson        String?
  createdAt                DateTime @default(now())
  updatedAt                DateTime @updatedAt

  user            User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  requirements    Requirement[]
  testCases       TestCase[]
  scenarios       TestScenario[]
  runs            Run[]
  documents       Document[]
  locators        KnowledgeBaseLocator[]
  actionMemories  ProjectActionMemory[]
  prs             GovernancePR[]
  blockers        BlockedItem[]
  agentRuns       AgentRun[]
  discrepancies   Discrepancy[]
  sprints         Sprint[]
  diffContexts    DiffContext[]
  downloads       Download[]
  failurePatterns FailurePattern[]
  authFixtures    AuthFixture[]
  calibrations    Calibration[]
  scenarioGenerations ScenarioGeneration[]
  generationGuidance GenerationGuidance[]
  testDataSets    TestDataSet[]
  requirementClauses RequirementClause[]
  authProfiles    AuthProfile[]
  certifications  ExportCertification[]
  sourceArtifacts SourceArtifact[]

  @@index([userId])
  @@index([orgId])
}

// ── Download (Phase E10.5) ──────────────────────────────────
// Captured by the downloadWatcher service. One row per file the
// browser downloaded during a run. The Conductor's `assertion_check`
// can verify downloads via the linked RunResult, and Reports surfaces
// them in the run detail pane.
//
// `path` is the on-disk location under playwright/test-results/downloads/.
// We keep paths absolute so artifact-serving routes don't have to
// reconstruct them; the deleter on Run cleanup removes both row + file.
model Download {
  id                String   @id @default(uuid())
  projectId         String
  runResultId       String?
  suggestedFilename String // filename the page suggested (Content-Disposition)
  storedFilename    String // actual on-disk name (uuid-prefixed to avoid clobbering)
  path              String // absolute path on the QAAI server
  sizeBytes         Int      @default(0)
  mimeType          String?
  capturedAt        DateTime @default(now())

  project   Project    @relation(fields: [projectId], references: [id], onDelete: Cascade)
  runResult RunResult? @relation(fields: [runResultId], references: [id], onDelete: SetNull)

  @@index([projectId, capturedAt])
  @@index([runResultId])
}

// ── DiffContext (Phase E3) ──────────────────────────────────
// One row per fetched PR/branch/commit diff. The Architect reads the most
// recent DiffContext for a project (filtered by sprint when set) and uses
// it to bias scenario generation. Stale rows accumulate by design — they
// double as a history of "which changes the team tested against".
model DiffContext {
  id             String   @id @default(uuid())
  projectId      String
  sprintId       String? // when fetched in a sprint, scoped to it
  // Free-form identifier: PR number ("#123"), branch name, commit SHA, or
  // human label. Used in the UI; not a unique key.
  ref            String
  baseRef        String // the comparison base — usually defaultBranch
  // JSON-encoded array of { path, additions, deletions, status }.
  changedFiles   String
  // JSON-encoded array of derived module names (path-segment + fuzzy).
  changedModules String
  // Optional Claude-generated 2-sentence narrative.
  summary        String?
  fetchedAt      DateTime @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId, sprintId])
  @@index([projectId, fetchedAt])
}

// ── Sprint (B3 hybrid: per-project release cycle container) ──
// Holds Docs/Requirements/Runs/Blockers/PRs for one release. TestCases
// stay PROJECT-level (smoke tests reused across sprints) and reference
// the sprints they ran in via the SprintTestCase join. See BUILD_PLAN.md
// "Phase B" for the three options considered; B3 is what shipped.
model Sprint {
  id            String    @id @default(uuid())
  projectId     String
  name          String
  // 'planning' | 'in_progress' | 'completed' | 'archived'. Completed sprints
  // are read-only at the route layer (writes refuse with SPRINT_LOCKED).
  lifecycle     String    @default("in_progress")
  // Phase B+: sprint-scoped operator guidance, stacked on top of
  // Project.aiGuidance via promptCompose.joinGuidance. Example:
  // "this sprint focuses on checkout — bias scenarios toward payments flows".
  aiGuidance    String?
  // Planned end date for the sprint — drives the "days-to-cut" indicator
  // on the Overview sprint-health tile and the comparison view summary.
  // Nullable: legacy sprints + sprints without a planned end keep working.
  expectedEndAt DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  project Project          @relation(fields: [projectId], references: [id], onDelete: Cascade)
  cases   SprintTestCase[]

  @@index([projectId])
}

// ── Calibration (E4 — Calibrator MVP) ──────────────────────────────────────
model Calibration {
  id           String            @id @default(cuid())
  projectId    String
  project      Project           @relation(fields: [projectId], references: [id], onDelete: Cascade)
  status       String            @default("running")
  startUrl     String
  pagesCount   Int               @default(0)
  errorMessage String?
  createdAt    DateTime          @default(now())
  completedAt  DateTime?
  pages        CalibrationPage[]

  // P3 — role-aware, module-scoped, versioned atlas. The unit of work is the
  // slice (projectId, module, authProfileId, version). All nullable/defaulted so
  // a legacy whole-app calibration (module=null, authProfileId=null, version=1)
  // is unchanged. module = the Focus module ("pim", "checkout"); authProfileId =
  // the AuthFixture the crawl ran AS (null = unauthenticated/default identity).
  module          String?
  authProfileId   String?
  version         Int      @default(1)
  isCurrent       Boolean  @default(true)
  atlasFingerprint String? // aggregate of page snapshotHashes — the drift key
  staleAt         DateTime? // freshness horizon; past it, getCalibrationAtlas reports 'stale'

  // Planned-mapper redesign. crawlMode = shallow|standard|deep|focused (derived
  // from the generation mode — smoke/regression/complete/focus); it governs
  // pages-per-module, tab depth, and probe budget. coverageReportJson holds the
  // crawl-coverage summary (modules discovered/visited/skipped, pages per module,
  // duplicate states skipped, tabs discovered/visited/skipped, capability counts).
  // sufficiency = sufficient|partial|insufficient — the explicit, honest verdict
  // on whether this atlas is trustworthy enough for generation (never a silent
  // "ready"). All nullable so legacy rows + a pre-regen client keep working via
  // the same graceful try/catch ladder capabilitiesJson uses.
  crawlMode          String?
  coverageReportJson String?
  sufficiency        String?

  @@index([projectId])
  @@index([projectId, module, authProfileId, isCurrent])
}

model CalibrationPage {
  id            String      @id @default(cuid())
  calibrationId String
  calibration   Calibration @relation(fields: [calibrationId], references: [id], onDelete: Cascade)
  url           String
  normalizedUrl String
  pageRole      String?
  elementsJson  String
  // Visible page TEXT (headings, labels, column headers, static copy) as a
  // JSON string[] — distinct from elementsJson, which only holds INTERACTIVE
  // controls. This is the ground truth a TEXT/PAGE assertion is checked
  // against: it lets the Architect see the real labels a page shows and lets
  // groundAssertions() down-tier any expectedText that no calibrated page
  // actually displays. Nullable so pre-existing rows (interactive-only) keep
  // working; null = "text not captured for this page".
  textCorpus    String?
  snapshotHash  String?
  // P3 — typed capabilities for this page: CapabilityRecord[] (see
  // server/lib/capabilityVocabulary.js). Each record carries the capability type,
  // its supported operations, and Node-extracted VERIFIED-selector evidence — the
  // substrate the Architect/TestData/BDD layers compile typed steps from (never
  // free prose). Nullable so legacy pages (no capabilities) keep working.
  capabilitiesJson String?
  // ARIA LANDMARK accessible names on this page (navigation/region/banner/etc.)
  // as a JSON string[] — captured SEPARATELY from textCorpus, which now holds
  // only real CONTENT names. A landmark label ("Topbar Menu", "Sidebar") passes
  // any presence check whenever the landmark exists — even if the page is broken
  // — so it has zero diagnostic value as a TEXT assertion. The structural-label
  // gate (server/lib/groundAssertions.js) demotes any TEXT assertion whose
  // expectedText is ONLY a landmark name here and nowhere in content. Keyed off
  // ARIA role, not site-specific strings → generic across any website. Nullable
  // so pre-regen rows keep working; null = "landmark names not captured".
  structuralNamesJson String?
  // Planned-mapper redesign. stateKey = composite UI-state fingerprint
  // (normalized landed URL + pageRole + primary heading + active nav item +
  // stable text-corpus hash) — catches content-identical states the URL alone
  // cannot, so the crawl never re-maps the same screen reached two ways.
  // substatesJson = tab/subtab/panel SUBSTATES discovered on this page, each
  // { tabLabel, stateKey, controlSig, textCorpus, elements, capabilities } — the
  // safe, URL-less states (role=tab / aria-selected panels) the BFS can't reach
  // by navigation. Both nullable → pre-regen client + legacy rows keep working.
  stateKey      String?
  substatesJson String?
  capturedAt    DateTime    @default(now())

  @@index([calibrationId])
}

// Join: which TestCases were RUN inside which sprints. Populated when a
// Run starts (one row per scenario.case in the run). Used by the Sprint
// comparison view + carry-forward features in Phase B+.
model SprintTestCase {
  id         String   @id @default(uuid())
  sprintId   String
  testCaseId String
  createdAt  DateTime @default(now())

  sprint   Sprint   @relation(fields: [sprintId], references: [id], onDelete: Cascade)
  testCase TestCase @relation(fields: [testCaseId], references: [id], onDelete: Cascade)

  @@unique([sprintId, testCaseId])
  @@index([testCaseId])
}

model Document {
  id         String   @id @default(uuid())
  projectId  String
  sprintId   String?
  name       String
  mimeType   String?
  sizeBytes  Int
  content    String
  category   String   @default("other") // 'brd' | 'user-stories' | 'release-notes' | 'api-spec' | 'other'
  uploadedAt DateTime @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
  @@index([sprintId])
}

model Requirement {
  id               String   @id @default(uuid())
  projectId        String
  sprintId         String?
  sourceType       String // 'ado' | 'jira' | 'upload' | 'manual'
  sourceIdentifier String?
  title            String?
  content          String
  category         String   @default("other") // mirrors Document.category
  pulledAt         DateTime @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
  @@index([sprintId])
}

// ── TestDataSet (Round A — the "test data" input) ───────────
// Structured test DATA uploaded as .xlsx/.csv: the concrete inputs QA drives
// the app with (valid / invalid / boundary / locale rows). Unlike Document,
// which flattens everything to prose, this stays STRUCTURED (sheets → headers
// → rows) because the rows/columns ARE the value. The dataMapper agent binds
// columns to user-story/scenario step fields (mappingJson); the Architect then
// generates data-aware cases and codegen emits data-driven specs.
// Source grounding artifacts collected before generation. Firecrawl and future
// source-intake providers enrich requirements and hints, but never count as
// browser execution evidence unless Playwright later verifies them.
model SourceArtifact {
  id                     String   @id @default(uuid())
  projectId              String
  sprintId               String?
  generationId           String?
  source                 String   @default("firecrawl") // firecrawl | upload | manual | ai
  sourceArtifactVersion  String   @default("source_artifact_v1")
  sourceUrl              String?
  title                  String?
  content                String?
  artifactJson           String?
  requirementClausesJson String?
  businessRulesJson      String?
  acceptanceCriteriaJson String?
  pageHintsJson          String?
  fieldHintsJson         String?
  oracleHintsJson        String?
  capabilitySeedsJson    String?
  confidence             String   @default("discovered")
  verifiedByPlaywright   Boolean  @default(false)
  crawlDepth             Int?
  fetchedAt              DateTime @default(now())
  capturedAt             DateTime @default(now())
  expiresAt              DateTime?
  staleAt                DateTime?
  robotsPolicy           String?
  tenantAllowed          Boolean  @default(false)
  contentHash            String?
  hash                   String?
  freshness              String   @default("unknown") // fresh | stale | unknown
  redactionJson          String?
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
  @@index([projectId, generationId])
  @@index([source, freshness])
}

model TestDataSet {
  id          String   @id @default(uuid())
  projectId   String
  sprintId    String?
  name        String
  // JSON: { sheets: [{ name, headers: string[], rows: object[] }], rowCount }.
  // Kept verbatim from the parser so no structure is lost en route to mapping.
  sheetsJson  String
  // JSON mapping produced by the dataMapper agent (column → step field, row
  // classification). Null until mapping runs; user-editable in the UI.
  mappingJson String?
  // Step 3A — the canonical WorkbookContract (server/services/workbookContract.js)
  // built deterministically from sheetsJson at upload: schemaVersion, fileHash,
  // generatedAt, per-sheet manifests (structural purpose, row contracts, story-id,
  // row intent, expected columns BY ORACLE TYPE), findings, certification. The
  // reproducible data-oracle source consumed by mapping/generation/reports — so
  // they never re-guess the workbook. Nullable → pre-regen client + legacy rows
  // keep working via the graceful try/catch write ladder.
  workbookContractJson String?
  rowCount    Int      @default(0)
  uploadedAt  DateTime @default(now())

  project  Project           @relation(fields: [projectId], references: [id], onDelete: Cascade)
  mappings TestDataMapping[]

  @@index([projectId])
  @@index([sprintId])
}

// ── TestDataMapping (Enterprise Mode P4a — the approval ledger) ──────────────
// An IMMUTABLE, versioned snapshot of an APPROVED column→field mapping. The
// editable draft lives on TestDataSet.mappingJson; approving SNAPSHOTS it here as
// a frozen row (status 'approved'); changing an approved mapping requires a NEW
// version (the prior 'approved' row flips to 'superseded'). Generation pins a case
// to a specific (mappingId, version); run/export resolve by that pin, so an old
// case never silently consumes a newer approved mapping. See ENTERPRISE_MODE.md → "P4".
model TestDataMapping {
  id               String    @id @default(uuid())
  testDataSetId    String
  projectId        String
  version          Int // monotonic per testDataSetId
  status           String    @default("approved") // approved | rejected | superseded
  mappingJson      String // FROZEN snapshot of the draft at approval time
  verificationJson String? // testDataApproval.verifyMapping report captured at approval
  approvalNote     String? // required when approving over a warning finding (override reason)
  createdBy        String? // who authored/last-edited the draft (RBAC attribution, P9)
  approvedBy       String? // maker-checker attribution (P9 enforces approvedBy != createdBy)
  approvedAt       DateTime?
  rejectedReason   String?
  createdAt        DateTime  @default(now())

  testDataSet TestDataSet @relation(fields: [testDataSetId], references: [id], onDelete: Cascade)

  @@unique([testDataSetId, version])
  @@index([projectId])
  @@index([testDataSetId, status])
}

// ── RequirementClause (Enterprise Mode P2 — the requirements oracle) ────────
// An ATOMIC, independently-verifiable behaviour extracted from a source doc.
// Distinct from Requirement (which is a coarse source-system item: ADO/Jira/
// upload). The LLM proposes candidate clauses; Node owns the content-hash id,
// verifies the excerpt is a verbatim source substring, dedupes, and builds the
// RTM. This is the INDEPENDENT oracle: a `must` assertion's expected value must
// trace to one of these, never to the live app. See ENTERPRISE_MODE.md → "P2".
model RequirementClause {
  // Content-addressed: "REQ-" + sha1(sourceType + "\n" + normalize(excerpt)).
  // Deterministic across re-uploads of the same text → stable IDs, no random
  // LLM-invented IDs. NOT @default(uuid) — the caller supplies the hash id.
  id                  String    @id
  projectId           String
  sprintId            String?
  sourceType          String // 'BRD' | 'USER_STORY' | 'RELEASE_NOTE'
  sourceDocId         String?
  excerpt             String // verbatim span from the source document (audit proof)
  spanStart           Int?
  spanEnd             Int?
  behaviourText       String // the atomic, testable statement (LLM-phrased, for authoring)
  // Step 3B bridge — the user-story id (US-OHRM-001, US-123, "Story 12", …)
  // extracted GENERICALLY from the source text, so cases and workbook rows share a
  // join key for storyId-first data binding. Nullable → non-story sources + legacy
  // rows keep working.
  storyId             String?
  // JSON array of {sourceType, sourceDocId, spanStart, spanEnd} for the OTHER
  // sources that merged into this clause (dedupe across BRD/US/RN).
  sourcesJson         String?
  // RTM disposition. 'covered' is DERIVED (>= 1 case refs this clause); the
  // other two are explicit human dispositions that REQUIRE dispositionReason.
  coverageDisposition String    @default("uncovered") // covered | uncovered | manually_excluded | not_automatable
  dispositionReason   String?
  dispositionBy       String? // RBAC attribution (P9)
  dispositionAt       DateTime?
  createdAt           DateTime  @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
  @@index([sprintId])
}

model Discrepancy {
  id         String    @id @default(uuid())
  projectId  String
  kind       String // 'in_brd_not_in_release' | 'in_release_not_in_brd' | 'spec_mismatch' | 'requirement_conflict' | 'requirement_uncovered'
  summary    String
  detail     String
  severity   String    @default("info") // 'info' | 'warning' | 'critical'
  resolved   Boolean   @default(false)
  resolvedAt DateTime?
  createdAt  DateTime  @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId, resolved])
}

model TestScenario {
  id           String   @id @default(uuid())
  projectId    String
  name         String
  module       String
  priority     String // 'P0' | 'P1' | 'P2' | 'P3'
  category     String // 'positive' | 'negative' | 'edge' | 'boundary' | 'empty' | 'e2e'
  rationale    String
  dependencyOn String? // JSON-encoded array of scenario IDs
  source       String   @default("agent") // 'agent' | 'manual'
  impacted     Boolean  @default(false) // smart-selection: this scenario is affected by current release notes
  impactReason String? // why it was marked impacted
  // Versioning — which generation batch this scenario belongs to. A
  // regenerate creates a NEW ScenarioGeneration and keeps prior scenarios
  // (no destructive wipe), so the user can browse/select past generations.
  // Nullable for legacy rows until the backfill migration stamps them.
  generationId String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  project    Project             @relation(fields: [projectId], references: [id], onDelete: Cascade)
  cases      TestCase[]
  generation ScenarioGeneration? @relation(fields: [generationId], references: [id], onDelete: SetNull)

  @@index([projectId, priority])
  @@index([generationId])
}

// Versioning — one row per "Generate scenarios" batch for a project. The
// current generation (isCurrent=true, exactly one per project) is what every
// page shows by default; selecting a past generation re-skins Test Cases,
// Overview, and Reports to that batch's scenarios + the runs executed against
// it. Replaces the old destructive deleteMany-on-regenerate behaviour.
model ScenarioGeneration {
  id            String   @id @default(uuid())
  projectId     String
  version       Int // per-project incrementing version (1, 2, 3…)
  label         String? // short human summary of the generate config (depth/focus)
  isCurrent     Boolean  @default(true)
  scenarioCount Int      @default(0)
  caseCount     Int      @default(0)
  coveragePlanJson       String?
  coverageValidationJson String?
  coverageRepairJson     String?
  createdAt     DateTime @default(now())

  project   Project        @relation(fields: [projectId], references: [id], onDelete: Cascade)
  scenarios TestScenario[]
  cases     TestCase[]
  runs      Run[]

  @@unique([projectId, version])
  @@index([projectId, isCurrent])
}

model GenerationGuidance {
  id                   String   @id @default(uuid())
  projectId            String
  userId               String
  sprintId             String?
  generationId         String?
  scenarioId           String?
  testCaseId           String?
  scope                String // suite | scenario | case
  sourceSurface        String? // run-suite | test-cases | scenario-card | case-row
  instruction          String
  quickIntentsJson     String?
  normalizedDirectives String?
  status               String   @default("draft") // draft | applied | rejected
  appliedGenerationId  String?
  appliedScenarioId    String?
  appliedTestCaseId    String?
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
  appliedAt            DateTime?

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId, scope, status])
  @@index([projectId, generationId])
  @@index([scenarioId])
  @@index([testCaseId])
}

model TestCase {
  id                   String    @id @default(uuid())
  projectId            String
  scenarioId           String?
  // Back-relation for the SprintTestCase join. No own FK; this is just so
  // Prisma can navigate `testCase.sprintTestCases`.
  name                 String
  type                 String // 'smoke' | 'regression' | 'functional' | 'security' | 'boundary' | 'integration'
  module               String
  confidence           Int
  // Approval/lifecycle state ONLY. Do NOT overload this with execution
  // results — pass/fail/blocked/skipped belong on RunResult per-run. Derive
  // execution status by reading the latest RunResult for this test case
  // (see services/runs.js#withLatestResult).
  status               String    @default("pending") // pending | approved | rejected | running
  assertions           String
  steps                String? // JSON-encoded array of { order, action, target?, value?, expected? }
  specCode             String? // generated Playwright spec code
  // Free-form notes from the user that the Conductor / Critic / Supervisor
  // honour for this specific case on every future run. Example: "Always wait
  // for the loading spinner to disappear before clicking submit."
  userGuidance         String?
  // Case-level dependency graph. JSON-encoded array of TestCase IDs that
  // MUST have passed (or at least executed) before this case is run.
  // Architect emits this from the requirements ("Verify checkout" depends
  // on "Register user" + "Add to cart"); the runs service topologically
  // sorts the input testCaseIds and auto-includes missing prerequisites.
  // Null / empty array = standalone case (the common case).
  dependsOnIds         String?
  // Cross-case data chaining (sharedData sprint, 2026-05-30).
  //   producesData — JSON array of key names this case extracts at runtime
  //                  via the browser_extract_data tool (e.g. ["trackingId"]).
  //                  Architect declares; conductor honours.
  //   requiresData — JSON array of key names this case CONSUMES from
  //                  upstream cases (via Run.sharedData). The conductor
  //                  filters Run.sharedData by these keys and injects only
  //                  the requested subset into the per-case user message
  //                  (not the system prompt — preserves prompt cache).
  // P0-17 architect output validator rejects requiresData keys that no
  // upstream case (via dependsOnIds) produces.
  producesData         String?
  requiresData         String?
  // TestData Round B — data-driven (matrix) execution binding. JSON-encoded:
  //   { sheet, rowSelector?, columnToField?, expectedColumn?, rowClassColumn? }
  // Architect emits it when a scenario maps to an uploaded data sheet; the
  // conductor expands the case to run ONCE PER ROW of that sheet, substituting
  // the row's {{token}} values into steps/assertions. Null = not data-driven →
  // the case runs exactly once (the common case; behaviour unchanged). When
  // the binding omits columnToField/expectedColumn, the run resolves them from
  // the project's TestDataSet mapping, so a bare { sheet } binding is enough.
  dataBindingJson      String?
  // Enterprise Mode P2 — traceability to the requirements oracle. JSON array of
  // RequirementClause ids this case verifies (>= 1 for an automatable case once
  // the oracle is wired into generation). The "covered" axis of the RTM is
  // derived from these refs. Null = not yet traced (pre-P2-integration cases).
  requirementRefs      String?
  // Step 3B bridge — the user-story id this case covers, DERIVED from its
  // requirementRefs' RequirementClause.storyId (stamped only when all refs agree
  // on one storyId). Null when no ref carries a storyId; cases whose refs disagree
  // are flagged ambiguous (not stamped). The join key for storyId-first data binding.
  storyId              String?
  // Enterprise Mode P3d — the bound capability-operation plan for this case.
  // JSON: { status: 'complete'|'incomplete', operations: [{operation, capabilityRef,
  // params}], dropped: [{operation, reason, detail}] }. The Architect proposes
  // operations from the module's verified capability menu; Node disposes
  // (operationPlan.markCaseOperations) — invalid/foreign ops are dropped and the
  // case is marked 'incomplete'. The BDD package-export gate consumes status +
  // dropped to refuse shipping a complete-looking feature for an incomplete case;
  // the BDD bridge consumes operations. Null = no plan (legacy / whole-project /
  // manual). Populated only on module-scoped generation once capabilities exist.
  operationsJson       String?
  // Enterprise Mode P4b — the declared business IDENTITY this case runs as
  // (references an AuthProfile.name). Null = legacy default-fixture behavior,
  // unchanged. Selects the atlas slice the case grounds against (P3b pickSlice
  // wrong-role firewall) and how run/export authenticates (AuthProfile.disposition).
  authProfile          String?
  // QAAI 2.0 Phase 1 - scenario-quality contract stamped by the generation
  // compiler: role/auth assumption, preconditions, session cleanup, vague/duplicate
  // blockers, and native-agent Markdown readiness metadata.
  qualityContractJson  String?
  // Cached readiness contract. TestCase.status remains human approval lifecycle;
  // compileCaseReadiness() is authoritative for run/export safety.
  readinessStatus          String    @default("needs_review")
  readinessReasonsJson     String?
  readinessContractVersion String?
  readinessComputedAt      DateTime?
  approvalEligibility      String    @default("eligible")
  runEligibility           String    @default("blocked")
  sessionMode              String    @default("fresh")
  producesStateJson        String?
  requiresStateJson        String?
  failurePolicy            String    @default("continue_independent")
  rowExecutionPlanJson     String?
  rowCoverageStatus        String?
  skippedRowsJson          String?
  // Phase D — Manual vs Automation classifier. The Architect labels each
  // case during generation. "automatable" (default) is run by the agent
  // end-to-end. "manual" is reserved for cases that genuinely cannot be
  // browser-automated (legal copy review, aesthetic judgment, real
  // payment, accessibility audit, multi-device coordination). MOST
  // half-manual cases are handled at the STEP level via the synthetic
  // human_input tool call — only fully-unautomatable cases land here.
  automatability       String    @default("automatable")
  automatabilityReason String?
  // AI-generated step-by-step guide for the tester to perform a manual
  // case by hand. Lazily generated the first time the user expands the
  // case on the Manual tab; cached afterward.
  manualGuide          String?
  // Timestamp when the tester marked the manual case complete. Used to
  // unblock downstream automation cases that depend on it.
  manualCompletedAt    DateTime?
  // Phase H M1 — structured assertion records emitted natively by the
  // Architect (replaces post-hoc parsing of the free-form `assertions`
  // prose). JSON-encoded array of records:
  //   { id, type, payload, targetUrl?, checkAt, parseFailed?, source }
  // - id: stable UUID assigned at TC creation; persisted; same across all
  //   runs of this TC. Cross-TC-regeneration produces new IDs (different
  //   TC row, different test logically).
  // - type: 'TEXT' | 'URL' | 'ROLE' | 'DOWNLOAD' | 'FORBIDDEN_TEXT' |
  //         'FORBIDDEN_ROLE' | 'EVALUATE'.
  // - payload: shape varies by type (e.g. { expectedText: '...' }).
  // - targetUrl: normalized path the assertion expects; absence means
  //   the assertion is checkable on any page.
  // - checkAt: 'end' (default; ratifiable post-loop against final
  //   snapshot) | 'transient' (must be checked mid-loop; post-loop
  //   ratification of a missed transient → uncheckable(transient_window_missed)).
  // - parseFailed: true when the legacy LLM migration could not decompose
  //   the prose into a typed record; routes to
  //   uncheckable(declared_assertion_unparseable) at runtime.
  // - source: 'architect' | 'calibrator_grounded' (Phase 3) | 'historical_backfill'.
  // Free-form `assertions` field retained ONLY for human-readable summary
  // on the Test Cases page — not source of truth for verification.
  declaredAssertions   String?
  // E3 — business risk tier. Drives the release recommendation engine:
  // any P0 failure → unconditional NO_GO regardless of overall pass rate.
  // Architect assigns at generation time based on module/keyword classification.
  // P1 default: existing cases unaffected until Architect re-classifies them.
  businessRisk         String    @default("P1") // P0 | P1 | P2
  // Versioning — generation batch this case belongs to (mirrors its scenario).
  generationId         String?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  project         Project             @relation(fields: [projectId], references: [id], onDelete: Cascade)
  scenario        TestScenario?       @relation(fields: [scenarioId], references: [id], onDelete: SetNull)
  generation      ScenarioGeneration? @relation(fields: [generationId], references: [id], onDelete: SetNull)
  results         RunResult[]
  // Back-relations for the SetNull FKs declared on GovernancePR / BlockedItem.
  // Without these, deleting a TestCase orphaned PRs and blockers by leaving
  // testCaseId pointing at a non-existent row, contaminating dashboard counts.
  prs             GovernancePR[]
  blockers        BlockedItem[]
  sprintTestCases SprintTestCase[]

  @@index([projectId, status])
  @@index([projectId, readinessStatus])
  @@index([projectId, runEligibility])
  @@index([scenarioId])
}

model Run {
  id          String    @id @default(uuid())
  userId      String
  projectId   String
  // FK to Sprint when the run was tagged at start (B3). Stays NULL for
  // legacy runs (pre-Sprint) and runs started without a current sprint.
  sprintId    String?
  sprintName  String
  status      String    @default("running") // running | completed | failed | cancelled
  // Counters denormalised from RunResult for fast list rendering. Keep in
  // sync via recomputeRunCounters() in services/runs.js — never mutate one
  // of the four without recomputing all four from RunResult rows.
  // `blocked` and `skipped` mean different things — `blocked` is an
  // environmental/browser failure that prevented assertions from running,
  // `skipped` is `test.skip()` / `--grep` deselection that the engineer
  // intentionally excluded. Conflating them mis-leads release decisions.
  passed      Int       @default(0)
  failed      Int       @default(0)
  blocked     Int       @default(0)
  skipped     Int       @default(0)
  // Phase H+2 (P0-9) — needs_human is a peer of pass/fail/blocked/skipped,
  // emitted by the mechanical verdict layer when execution completed but
  // verification couldn't be evaluated (e.g., all assertions uncheckable
  // because the agent never reached the target page, or assertion text
  // was ungrounded). Hidden from Run counters before this column existed,
  // producing "dashboard says 12 cases ran but the DB has 31 RunResults"
  // — the demo-killer caught 2026-05-29.
  needsHuman  Int       @default(0)
  // Cross-case data chaining (sharedData sprint, 2026-05-30).
  // JSON object — accumulated key/value pairs extracted via the
  // browser_extract_data tool. Values are primitive (string/number/boolean
  // only — keep the bag flat). Read by downstream cases that declare
  // requiresData. Persistence semantics: every successful extraction does
  // a read-modify-write merge against this column. Existing keys can be
  // overwritten (last write wins) — the architect's P0-17 grounding rule
  // is what prevents conflicting producers in practice.
  sharedData  String?
  startedAt   DateTime  @default(now())
  completedAt DateTime?
  // Phase H M1 — captured at run-start from Project.verdictMode ?? env
  // QAAI_VERDICT_MODE. Immutable for the duration of this run; the
  // Conductor reads this value per-case and dispatches to the legacy
  // or mechanical verdict pipeline accordingly. Mid-run env-var flips
  // do NOT affect in-flight runs — coherent reports require a single
  // verdict logic for the whole suite.
  verdictMode String    @default("legacy") // 'legacy' | 'mechanical_v1'
  // Verifier mode for THIS run. 'deterministic' (default) uses only
  // _checkAssertionOnce's normalised substring/role/url match.
  // 'semantic_fallback' adds a single LLM call on each deterministic miss
  // — the verifier asks Claude "does this snapshot satisfy the assertion?"
  // and records source='semantic_fallback' on rescued outcomes. Used by
  // the Blocked-page "Rerun with AI verification" flow. Immutable for the
  // duration of the run (same coherence rule as verdictMode).
  verifierMode String   @default("deterministic") // 'deterministic' | 'semantic_fallback'
  // Versioning — which scenario generation was current when this run started.
  // Lets Reports/Overview filter runs to the selected generation. Stamped at
  // run-start; null for legacy runs until backfilled.
  generationId String?
  config      String? // JSON-encoded

  user             User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  project          Project             @relation(fields: [projectId], references: [id], onDelete: Cascade)
  generation       ScenarioGeneration? @relation(fields: [generationId], references: [id], onDelete: SetNull)
  results          RunResult[]
  certifications   ExportCertification[]

  @@index([userId, projectId])
  @@index([sprintId])
}

model RunResult {
  id                       String   @id @default(uuid())
  runId                    String
  testCaseId               String
  status                   String // pass | fail | blocked | skipped
  durationMs               Int?
  error                    String?
  screenshots              String   @default("[]") // JSON-encoded string[]. Postgres can use String[].
  video                    String?
  trace                    String?
  networkLog               String? // JSON-encoded array of {url, method, status, ms}
  domSnapshots             String? // JSON-encoded array of {step, html}
  // Reporter agent output
  rcaWhat                  String?
  rcaWhy                   String?
  rcaFix                   String?
  rcaClass                 String? // 'locator' | 'data' | 'timing' | 'backend' | 'env' | 'unknown'
  rcaConfidence            Int? // 0-100
  ticketId                 String? // external Jira/ADO id, e.g. "ACME-123" or "9876"
  ticketUrl                String?
  // Conversational follow-ups on this failure. JSON-encoded array of
  // { role: 'user' | 'assistant', content: string, ts: string-ISO }.
  // Populated by POST /runs/:r/results/:res/chat. Lives on the result so
  // every result gets its own thread (no cross-test bleed).
  chatHistory              String?
  // Phase E4 — visual regression. baselineScreenshot is the served URL
  // ('/artifacts/...') of the first-pass screenshot kept as the canonical
  // look. visualVerdict / visualDiffSummary record the last visualCritic
  // pass when one ran for this result.
  baselineScreenshot       String?
  visualVerdict            String? // 'pass' | 'fail' | 'inconclusive'
  visualDiffSummary        String? // free-form 1-3 sentence narration
  visualDiffs              String? // JSON array of {region, before, after, severity}
  // Per-step verdicts (Bug B fix). JSON-encoded array of
  // { index, status: pass|fail|blocked|skipped|pending, error? }.
  // Nullable so legacy rows (before this column existed) survive untouched.
  stepResults              String?
  // Phase H Stage 0.5 — rich per-turn telemetry written to a gzipped file
  // (`playwright/telemetry/<runId>/<runResultId>.json.gz`). Holds full
  // uncapped snapshots, per-turn token usage, elapsed-ms, the assistant's
  // text output verbatim, and stability-iteration counts. This column
  // stores the absolute path on the QAAI server; the file is what Stage 2's
  // replay harness will read. Nullable so legacy rows + early-Phase-H runs
  // without telemetry remain valid.
  richTraceFile            String?
  // Phase H Stage 1.5 — assertion-gate observation in SOFT-FAIL mode.
  //
  // The gate's case-level rule: status='pass' + ZERO assertion_check calls
  // AND at least one declared assertion → would-reject.
  // In soft-fail mode the gate ONLY records its decision; it does NOT
  // mutate status. The persisted fields are what the eventual flip-to-
  // hard-reject decision rests on (the WS log entry evaporates with
  // subscribers).
  //
  // assertionGateReason carries the per-assertion breakdown EVEN when
  // the case-level gate didn't fire — e.g. "3 declared, 1 unchecked:
  // 'user lands on dashboard'". That gives end-of-stage analysis both
  // signals (case-level + per-assertion) so the flip threshold can be
  // picked from observed data rather than pre-committed to a granularity.
  assertionGateWouldReject Boolean  @default(false)
  assertionGateReason      String?
  // Phase H M1 — mechanical verdict layer columns. All additive; legacy
  // rows default to verdictVersion='legacy' and are never mutated (per
  // [[preserve-trial-data]] — the trial-run history is the UI fixture set).
  //
  // verdictVersion: 'legacy' (status column was computed by pre-M4 logic,
  //   including agent's self-reported final_verdict) | 'mechanical_v1'
  //   (status was computed by computeVerdict() from recorded facts).
  // verdictMode: captured at Run.verdictMode start; mirrors here for
  //   per-RunResult queryability and immutability.
  // agentClaimedVerdict: the verdict the agent passed to final_verdict
  //   (or null if it never called the tool). Recorded for telemetry but
  //   does NOT influence status under mechanical_v1.
  // flipDirection: computed at write time from (agentClaimedVerdict, status).
  //   'FAIL_TO_PASS' | 'FAIL_TO_NEEDS_HUMAN' | 'PASS_TO_FAIL' |
  //   'PASS_TO_NEEDS_HUMAN' | 'NEEDS_HUMAN_TO_FAIL' | 'NEEDS_HUMAN_TO_PASS'
  //   | 'OTHER' | null (when agent and mechanical agreed).
  //   Drives the disagreement-rate dashboard metric.
  // assertionCheckResults: JSON array of every assertion_check call's
  //   outcome for this case. Each entry:
  //   { assertionId, outcome: 'matched'|'not_matched'|'uncheckable',
  //     reason, evidence?, source: 'agent'|'post_loop', ts }.
  //   Source of truth that computeVerdict() reads.
  // mechanicalVerdictReason: the `reason` string from computeVerdict()
  //   (e.g. 'assertion_not_matched', 'assertion_uncheckable',
  //   'no_assertions_declared', 'turn_ceiling'). Null when status='pass'.
  verdictVersion           String   @default("legacy")
  verdictMode              String   @default("legacy")
  agentClaimedVerdict      String?
  flipDirection            String?
  assertionCheckResults    String?
  mechanicalVerdictReason  String?
  failureExplanation       String?
  // E0 — structured blocked-reason attribution. One of:
  // selector_not_found | selector_quarantined | auth_required | session_expired |
  // page_not_reached | unexpected_modal | assertion_uncheckable | agent_loop |
  // env_config | multi_tab_required | iframe_required | failed_prereq | unknown
  // Null for non-blocked statuses. Enables per-reason improvement measurement.
  // Enterprise Mode P5 added `failed_prereq`: a dependent case the conductor did
  // NOT execute because a prerequisite (via TestCase.dependsOnIds) did not pass.
  // It is its OWN reason — visibly distinct from app-fail / script-fail / the
  // environmental blocked reasons above — so Reports never mislabels a gated case
  // as an app failure. See server/services/dependencyGraph.js.
  blockedReason            String?
  // Enterprise Mode P5 — EVIDENCE INHERITANCE for a failed_prereq block. When a
  // dependent is gated, its result points at the EXACT prerequisite that caused
  // it, so Reports + evidence bundles answer "blocked by what?" without manual
  // reconstruction. All null for normally-executed cases (additive, inert until
  // the P9 flag enforces gating).
  //   blockedByTestCaseId  — the failed/blocked prerequisite TestCase.id
  //   blockedByRunResultId — that prerequisite's RunResult.id in THIS run (if known)
  //   blockedByReason      — the prerequisite's own outcome (e.g. 'fail',
  //                          'blocked:selector_not_found') — the root cause
  //   dependencyPath       — JSON [{id,name,status}] root-cause-first chain for
  //                          multi-hop chains (A fail → B → C shows [A,B] on C)
  blockedByTestCaseId      String?
  blockedByRunResultId     String?
  blockedByReason          String?
  dependencyPath           String?
  // Enterprise Mode P6 — the ReplayIR pinned to THIS result. JSON envelope:
  // { ir, complete, gaps, emittedAt, emitterVersion }. `ir` is the frozen ReplayIR
  // (server/services/codegen/adapters/frameworkAdapter.js), mechanically emitted from
  // the recorded MCP trace + declared assertions + recorded assertion_check outcomes +
  // this result's verdict. `complete:false` + `gaps` = trace evidence the emitter
  // REFUSED to fabricate → the export lane treats the case as unsupported (never
  // silently falls back to AI-written code). Additive nullable; emission NEVER breaks
  // the run (failure → null + logged). P7 reads THIS column (one result → one IR,
  // verdict/data-row/auth/cause all attached), never a "latest generated IR".
  replayIrJson             String?
  // Contract-first codegen spine. executionContractJson is the planned executable
  // contract for this case/row before export; actionGraphJson is the executed,
  // proof-attached graph that certified codegen must render. ReplayIR remains an
  // audit trail, not the source of truth for certification.
  executionContractJson     String?
  actionGraphJson           String?
  // TestData Round B — per-row (matrix) execution tagging. When a data-driven
  // case fans out, each data row produces its own RunResult tagged with:
  //   dataRowIndex — 0-based position of the row within its data set
  //   dataRowLabel — human label, e.g. "Row 2 · negative · Admin"
  //   dataSetName  — the source sheet name
  // All null for ordinary (non-data-driven) cases → legacy rows + the common
  // path are unchanged. The frontend groups results by testCaseId and shows
  // each row under the case via dataRowLabel.
  dataRowIndex             Int?
  dataRowLabel             String?
  dataSetName              String?
  // Phase C — Certification Pipeline. JSON blob tracking this result's export state.
  // Shape: { state, gaps, contractAt, repairRound, certifiedAt, parityReport, artifacts, pipelineTraceId }
  // state: 'not_exportable' | 'incomplete_evidence' | 'repairing' | 'draft' | 'certified'
  // Written by emitJourneySpecs / executionHarness. Null = legacy run (pre-Phase C).
  exportMeta               String?
  // Capture-first evidence spine. These do not replace `status`: executionStatus
  // is the functional browser outcome, evidenceStatus is export-evidence
  // completeness, and scriptStatus is generated/certified state. Legacy rows
  // remain diagnostic_only until replayed through capture-first execution.
  overallRunStatus          String?
  executionStatus           String?
  evidenceStatus            String?
  scriptStatus              String?
  evidenceCompletenessJson  String?
  createdAt                DateTime @default(now())

  run       Run        @relation(fields: [runId], references: [id], onDelete: Cascade)
  testCase  TestCase   @relation(fields: [testCaseId], references: [id], onDelete: Cascade)
  downloads Download[]
  actionEvidences ActionEvidence[]
  locatorRecipes LocatorRecipe[]
  assertionEvidences AssertionEvidence[]
  authSetupEvidences AuthSetupEvidence[]
  traceArtifacts TraceArtifact[]
  replayIrCertifications ReplayIRCertification[]
  evidenceCompletenessLedgers EvidenceCompletenessLedger[]
  navigationEvidences NavigationEvidence[]

  @@index([runId])
  // Phase H M1 — composite index for the disagreement-rate dashboard query
  // which scans by (version, recency, direction). Without this the
  // rolling-7-day GROUP BY scans the full table as RunResult grows.
  @@index([verdictVersion, createdAt, flipDirection])
  // TestData Round B — fetch every fan-out row of one case in a run.
  @@index([runId, testCaseId])
}

