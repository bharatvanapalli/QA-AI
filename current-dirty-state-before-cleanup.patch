+  if (!errText) return false;
+  const s = String(errText);
+  // Zod's structural fingerprint: paired keys in a JSON-ish error envelope.
+  // We require at least two of the three (code+path, code+expected,
+  // path+expected) so a stray "invalid_type" in legitimate error prose
+  // doesn't false-positive.
+  const hasCodeInvalidType = /"code":\s*"invalid_type"/.test(s);
+  const hasExpectedKey = /"expected":\s*"(string|number|boolean|object|array)"/.test(s);
+  const hasPathKey = /"path":\s*\[/.test(s);
+  const hasZodHeader = /^### Error \[/m.test(s) || /^### Error\s/m.test(s);
+  const signals = [hasCodeInvalidType, hasExpectedKey, hasPathKey, hasZodHeader].filter(Boolean).length;
+  return signals >= 2;
+}
