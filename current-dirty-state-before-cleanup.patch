+    /no\s+element(s)?\s+match/.test(s) ||
+    /selector.*(not\s+found|did\s+not\s+match)/.test(s) ||
+    /ref\s+(not\s+found|expired|stale|missing|no\s+longer)/.test(s) ||
+    /aria(-snapshot)?\s+ref.*(stale|expired|not\s+found)/.test(s) ||
