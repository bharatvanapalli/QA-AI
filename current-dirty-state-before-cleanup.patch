+}
+
+function LocatorAtlasMetric({ label, value, tone }) {
+  const cls = {
+    success: 'bg-success-50 text-success-800 border-success-100',
+    warn: 'bg-warn-50 text-warn-800 border-warn-100',
+    danger: 'bg-danger-50 text-danger-800 border-danger-100',
+    info: 'bg-info-50 text-info-800 border-info-100',
+  }[tone] || 'bg-ink-50 text-ink-700 border-ink-100';
+  return (
+    <div className={`rounded-lg border px-2.5 py-2 ${cls}`}>
+      <div className="text-base font-semibold leading-none tabular-nums">{value}</div>
+      <div className="mt-1 truncate text-[10px] font-semibold uppercase tracking-wide opacity-75">{label}</div>
+    </div>
+  );
+}
+
+function LocatorAtlasStep({ step, index }) {
+  const selected = step.selected || {};
+  const status = step.exportGate?.status || selected.confidence || 'draft';
+  const gate = locatorGateMeta(status);
+  const GateIcon = gate.icon;
+  const fingerprint = step.fingerprint || selected.fingerprint || null;
+  const weaknesses = asArray(step.weaknesses);
+  const proof = selected.proof || {};
+  return (
+    <div className="grid gap-3 px-4 py-3 text-xs lg:grid-cols-[minmax(160px,0.9fr)_minmax(260px,1.4fr)_minmax(180px,0.8fr)] lg:items-start">
+      <div className="min-w-0">
+        <div className="flex flex-wrap items-center gap-2">
+          <span className="font-mono text-[11px] font-semibold text-ink-400">#{index + 1}</span>
+          <span className={`inline-flex h-5 items-center gap-1 rounded-full border px-2 text-[10px] font-semibold ${gate.cls}`}>
+            <GateIcon className="h-3 w-3" aria-hidden="true" />
+            {gate.label}
+          </span>
+        </div>
+        <div className="mt-1 truncate text-sm font-semibold text-ink-950" title={step.elementLabel || step.narration || ''}>
+          {step.elementLabel || step.narration || 'Unnamed locator'}
+        </div>
+        <div className="mt-0.5 truncate text-ink-500" title={step.pageUrl || ''}>
+          {compactText(step.pageUrl, 'No page URL')}
+        </div>
+      </div>
+
+      <div className="min-w-0 rounded-lg bg-ink-900 px-3 py-2 text-info-100">
+        <code className="block overflow-x-auto whitespace-nowrap font-mono text-[11px]">
+          {selected.expression || 'No selected expression'}
+        </code>
+        <div className="mt-2 flex flex-wrap gap-1.5 text-[10px] text-ink-300">
+          <span>strategy: {compactText(selected.strategy)}</span>
+          <span>score: {selected.score ?? 'n/a'}</span>
+          <span>count: {proof.count ?? 'n/a'}</span>
+          <span>same element: {proof.sameElement === true ? 'yes' : 'not proven'}</span>
+        </div>
+      </div>
+
+      <div className="min-w-0 space-y-2">
+        <div className="rounded-lg border border-info-100 bg-info-50 px-3 py-2 text-info-800">
+          <div className="flex items-center gap-1.5 font-semibold">
+            <Fingerprint className="h-3.5 w-3.5" aria-hidden="true" />
+            {fingerprint?.hash ? shortHash(fingerprint.hash) : 'No fingerprint'}
+          </div>
+          <div className="mt-1 truncate text-[11px] text-info-700">
+            {fingerprint?.semantic?.role || 'role n/a'} / {fingerprint?.semantic?.accessibleName || fingerprint?.semantic?.placeholder || fingerprint?.semantic?.testId || 'identity n/a'}
+          </div>
+        </div>
+        {weaknesses.length > 0 && (
+          <div className="flex flex-wrap gap-1">
+            {weaknesses.slice(0, 4).map((weakness) => (
+              <span key={weakness} className="rounded-full bg-warn-50 px-2 py-0.5 text-[10px] font-semibold text-warn-800 ring-1 ring-warn-100">
