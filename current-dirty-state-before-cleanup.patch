+      .replace(/^\^/, '')        // strip leading anchor
+      .replace(/\$$/, '')         // strip trailing anchor
+      .replace(/\\\\\./g, '.')    // \\. → . (paranoid; covers triple-escape too)
+      .replace(/\\\./g, '.')      // \. → .
+      .replace(/\\\//g, '/')      // \/ → /
