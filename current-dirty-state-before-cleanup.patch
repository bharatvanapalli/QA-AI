+  if (isSearchPack) {
+    add({
+      key: 'no_record',
+      kind: 'no_record',
+      name: `${title} no matching result`,
+      category: 'negative',
+      rowIntent: rowIntents.includes('negative') ? 'negative' : 'no_record',
+    });
+  }
