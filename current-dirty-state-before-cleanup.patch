+async function run({ apiKey, model, requirements, onLog = async () => {}, onProgress, signal, onRateLimit, extraGuidance, provider: providerName, priorContext, siteContext, testData, requirementClauses = [], contextMode = 'additive', knownModules = [], capabilities = [], module: moduleScope = null, coveragePlan = null, singleScenario = false, behaviorGrounding = null, projectId = null, calibrationAtlas = null, appCapabilityMap = null }) {
