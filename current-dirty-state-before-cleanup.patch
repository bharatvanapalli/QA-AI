+// Auto-ref injection (Mark II self-sufficiency): when the model targets an
+// element by label but omits the [ref], find the best-matching ref in the
+// current snapshot by accessible-name word overlap. This lets the Conductor
+// self-resolve instead of depending on the model always passing a ref â€” the
+// injected ref then flows through the live-ref dispatch path (which excavates a
+// real locator for codegen). Generic: matches on the element's own role/name in
+// the snapshot, never on any site-specific string. Returns a ref token or null.
+function findRefForLabelInSnapshot(snapshotText, label) {
+  if (!snapshotText || !label) return null;
+  const normLabel = String(label).toLowerCase().replace(/[^a-z0-9\s]/g, ' ').replace(/\s+/g, ' ').trim();
+  const labelWords = normLabel.split(' ').filter((w) => w.length > 2);
+  if (!labelWords.length) return null;
+  const CLICKABLE = new Set(['button', 'link', 'menuitem', 'option', 'tab', 'checkbox',
+    'radio', 'switch', 'combobox', 'listbox', 'generic', 'listitem', 'cell', 'row', 'img',
+    'heading', 'text', 'group', 'banner', 'navigation']);
+  let best = null;
+  for (const line of String(snapshotText).split(/\r?\n/)) {
+    const m = line.match(/\[ref=(e\d+)\]/i);
+    if (!m) continue;
+    const parsed = mcp.parseSnapshotLine ? mcp.parseSnapshotLine(line) : null;
+    const role = String(parsed?.role || '').toLowerCase();
+    // Accept clickable roles, or any element with no recognised role (custom
+    // generic/div widgets) â€” those are exactly the nameless dropdowns we target.
+    if (role && !CLICKABLE.has(role)) continue;
+    const lineNorm = line.toLowerCase()
+      .replace(/\[ref=e\d+\]/i, ' ')
+      .replace(/[^a-z0-9\s]/g, ' ')
+      .replace(/\s+/g, ' ');
+    const hits = labelWords.filter((w) => lineNorm.includes(w)).length;
+    if (hits === 0) continue;
+    const score = hits / labelWords.length;
+    if (score >= 0.6 && (!best || score > best.score)) best = { ref: m[1], score };
+  }
+  return best ? best.ref : null;
+}
