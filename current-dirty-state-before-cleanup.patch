+    if (entry?.testCaseId) manifestTestCaseIds.add(entry.testCaseId);
+  }
+  for (const item of assistantArray(manifest?.blocked)) {
+    if (item?.testCaseId) manifestTestCaseIds.add(item.testCaseId);
+  }
