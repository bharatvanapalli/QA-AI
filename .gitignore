# Dependencies
# node_modules/ included for zero-install offline VM deployment
.pnp.*

# Build outputs
dist/
build/
.vite/

# Logs
*.log
npm-debug.log*
yarn-error.log*
pnpm-debug.log*

# Environment & secrets — NEVER commit these
.env
.env.local
.env.*.local
.env.development
.env.production

# Local SQLite DB — contains encrypted Claude/Gemini API keys + user data
prisma/dev.db
prisma/dev.db-journal
prisma/dev.db-wal
prisma/dev.db-shm
prisma/*.db
prisma/*.db-journal
prisma/*.db-wal
prisma/*.db-shm
prisma/*.sqlite
prisma/*.sqlite-journal
dev.db
*.db
*.db-wal
*.db-shm
*.sqlite

# Everything under playwright/ is runtime output, not source: per-run
# evidence journals, generated scripts/BDD/telemetry keyed by real project
# and run IDs, and scaffolding rewritten on the next conductor run. All of
# it can contain real captured data from live target sites — never commit
# any of it. If a genuine hand-written source file is ever added under
# playwright/, add a narrow exception for it here rather than removing
# this rule.
playwright/

# Server-side debug / one-shot scripts output
server/scripts/*.output.json

# Playwright MCP subprocess logs (per-session, not source)
.playwright-mcp/

# Debug screenshots / one-off captures at repo root
/tc*.png
/screenshot-*.png
/debug-*.png
/register-*.png
/registration-*.png

# IDE / editor
.vscode/
.idea/
*.swp
*.swo
*~

# OS
.DS_Store
Thumbs.db
ehthumbs.db
desktop.ini

# Coverage
coverage/
*.lcov
.nyc_output/

# Claude Code local context (per-machine)
.claude/

# Generated runnable test execution folders
playwright-runnable/
